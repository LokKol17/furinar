import { Tema, BotaoIcone, BotaoTitulo, BarraDeslizante, CampoBusca, CaixaSelecao, CampoTexto, BotaoTexto } from "theme.slint";
import { I18n } from "i18n.slint";
import { TelaImersiva } from "imersivo.slint";
import { LinhaPainel, CartaoAlbum } from "painel.slint";
import { JanelaInfo, CandidatoInfo, ItemRevisao } from "info.slint";
import { MiniPlayer } from "mini.slint";

/// Linha da playlist do modo normal.
export struct LinhaLista {
    texto: string,
    favorita: bool,
}

export component MainWindow inherits Window {
    title: "Furinar Audio Player";
    // Tamanho fixo no modo normal; o imersivo libera para a tela cheia crescer
    preferred-width: modo_mini ? 380px : 660px;
    preferred-height: modo_mini ? 112px : 734px;
    min-width: modo_mini ? 380px : 660px;
    min-height: modo_mini ? 112px : 734px;
    max-width: modo_imersivo ? 16384px : (modo_mini ? 380px : 660px);
    max-height: modo_imersivo ? 16384px : (modo_mini ? 112px : 734px);
    // Mini player por cima das outras janelas (no Wayland o compositor
    // decide e costuma ignorar)
    always-on-top: modo_mini;
    background: Tema.fundo_janela;

    // Sem moldura nativa: a barra de título é nossa. O Slint (winit) ainda
    // cuida do redimensionamento pelas bordas.
    no-frame: true;
    resize-border-width: 6px;
    icon: @image-url("assets/furinar_icon_quadrado.png");

    // Foco inicial vai para o FocusScope dos atalhos de teclado
    forward-focus: atalhos;

    in-out property <bool> tocando: false;
    /// 0 = desligado, 1 = faixa, 2 = lista
    in-out property <int> loop_modo: 0;
    in-out property <int> shuffle_modo: 0;
    in-out property <string> texto_play_pause: "Play";
    in-out property <string> texto_busca: "";
    in-out property <string> texto_loop: "Loop: Desl";
    in-out property <string> texto_shuffle: "Shuffle: Desl";
    in-out property <float> volume: 0.8;
    in-out property <float> progresso: 0.0;
    in-out property <string> texto_tempo: "00:00 / 00:00";
    in property <[LinhaLista]> musicas: [];
    /// Ordem da aba visível (posição em `opcoes_ordem`).
    in property <int> ordem_atual: 0;
    /// A faixa que toca está nas favoritas.
    in property <bool> favorita_atual: false;
    /// Restante do temporizador de sono ("" = desligado)
    in property <string> sono_texto: "";
    /// Letra sem tempos: mostrada inteira, sem destaque
    in property <bool> letra_livre: false;
    in property <string> crossfade_texto: "";
    in-out property <bool> replaygain: true;
    in-out property <bool> fundo_reativo: false;
    callback ordem_escolhida(int);
    callback favorita_alternada(int);
    callback alternar_favorita_atual();
    callback alternar_crossfade();
    callback alternar_replaygain(bool);
    callback alternar_fundo_reativo(bool);

    // Busca na web: tela de informações da faixa e lote da aba
    in-out property <bool> info_aberta: false;
    // Mini player
    in-out property <bool> modo_mini: false;
    in property <string> mini_titulo;
    in property <string> mini_artista;
    in property <image> mini_capa;
    in property <bool> mini_tem_capa;
    /// Faixa cuja capa está no mini (para descartar capa atrasada)
    in-out property <string> mini_chave;
    callback alternar_mini();
    in-out property <bool> config_aberta: false;
    in-out property <int> info_guia: 0;
    in property <string> info_titulo;
    in property <string> info_artista;
    in property <string> info_album;
    in property <bool> info_corrigida;
    in property <string> info_letra;
    in property <string> info_estado;
    in property <bool> info_ocupado;
    in property <[CandidatoInfo]> info_candidatos;
    in property <bool> lote_ativo;
    in property <float> lote_progresso;
    in property <string> lote_texto;
    in property <[ItemRevisao]> revisao;
    in property <string> tags_texto;
    in-out property <bool> letras_web: false;
    in-out property <bool> discord: false;
    callback alternar_discord(bool);
    // Scrobble
    in-out property <string> listenbrainz_token;
    in-out property <string> lastfm_chave;
    in-out property <string> lastfm_segredo;
    in property <bool> lastfm_conectado;
    in property <bool> lastfm_aguardando;
    in property <string> lastfm_estado;
    in property <string> scrobble_estado;
    callback listenbrainz_mudou(string);
    callback lastfm_credenciais_mudou(string, string);
    callback lastfm_conectar();
    callback lastfm_concluir();
    callback lastfm_desconectar();
    in-out property <string> chave_acoustid: "";
    callback abrir_info();
    callback info_buscar();
    callback info_aplicar(int, bool);
    callback info_restaurar();
    callback info_baixar_letra();
    callback lote_iniciar();
    callback lote_cancelar();
    callback revisao_decidir(int, bool);
    callback gravar_tags_aba();
    callback alternar_letras_web(bool);
    callback chave_acoustid_mudou(string);
    in-out property <int> indice_selecionado: -1;
    in property <[string]> abas: [];
    in-out property <int> aba_ativa: 0;
    /// Aba da pasta de onde vem o som agora (-1 se nada está tocando).
    in property <int> aba_tocando: -1;
    /// Recorte da letra ao redor da linha atual.
    in property <[string]> letra: [];
    /// Linha destacada dentro do recorte (-1 se nenhuma).
    in property <int> letra_destaque: -1;
    in-out property <bool> mostrar_letra: false;
    in-out property <bool> escanear_subpastas: false;
    /// Espelha `Tema.escuro` para o Rust conseguir ler e gravar o tema
    in-out property <bool> tema_escuro <=> Tema.escuro;

    // Modo imersivo (tela cheia). Tudo abaixo só é preenchido pelo Rust
    // enquanto o modo está ligado.
    in property <bool> modo_imersivo: false;
    in property <image> imv_fundo_a;
    in property <image> imv_fundo_b;
    in property <bool> imv_mostra_a: true;
    in property <bool> imv_tem_fundo: false;
    in property <bool> imv_fundo_pixelado: false;
    in property <image> imv_capa;
    in property <bool> imv_tem_capa: false;
    in property <string> imv_titulo: "";
    in property <string> imv_creditos: "";
    in property <string> imv_tecnico: "";
    in property <color> imv_cor: Tema.oceano;
    in property <bool> imv_tem_cor: false;
    in property <[float]> imv_barras: [];
    /// Letra inteira e índice absoluto da linha atual (o painel normal usa só
    /// um recorte; o imersivo rola o texto todo).
    in property <[string]> letra_completa: [];
    in property <int> letra_indice: -1;
    callback alternar_imersivo();
    /// Nome do arquivo de fundo global ("" = capa desfocada)
    in property <string> fundo_global_nome: "";
    callback escolher_fundo();
    callback limpar_fundo();
    callback letra_completa_clicada(int);
    // Painel da biblioteca do imersivo (lista virtualizada: só uma janela de
    // linhas a partir de `imv_painel_primeira`)
    in-out property <bool> imv_painel_aberto: false;
    in property <int> imv_painel_total: 0;
    in property <int> imv_painel_primeira: 0;
    in property <[LinhaPainel]> imv_painel_linhas: [];
    in property <[LinhaPainel]> imv_fila: [];
    private property <int> imv_pedido_rolar: 0;
    private property <int> imv_pedido_busca: 0;
    in-out property <bool> imv_so_letra: false;
    in-out property <bool> imv_config_aberta: false;
    /// Controles escondidos por inatividade
    in-out property <bool> imv_ocioso: false;
    in property <string> imv_relogio: "";
    /// Prévia da próxima nos últimos segundos ("" = escondida)
    in property <string> imv_proxima: "";
    /// Pulso do fundo com os graves (0..1)
    in property <float> imv_pulso: 0;
    in property <float> imv_letra_progresso: 0;
    in property <[CartaoAlbum]> imv_albuns: [];
    /// Guia do painel: 0 = biblioteca, 1 = a seguir, 2 = álbuns
    in-out property <int> imv_guia: 0;
    callback imv_guia_mudou(int);
    callback imv_albuns_rolou(int, int);
    callback imv_album_clicado(int);
    callback imv_painel_alternado(bool);
    callback imv_painel_rolou(int, int);
    callback imv_fila_clicada(int);
    callback alternar_sono();

    callback abrir_pasta();
    callback anterior();
    callback play_pause();
    callback parar();
    callback proxima();
    callback alternar_loop();
    callback alternar_shuffle();
    callback volume_mudou(float);
    callback progresso_mudou(float);
    callback seek_relativo(int);
    callback musica_selecionada(int);
    callback busca_mudou(string);
    callback letra_linha_clicada(int);
    callback aba_selecionada(int);
    callback fechar_aba(int);
    callback fecha_janela();
    callback alternar_escanear_subpastas(bool);
    callback minimizar();
    callback alternar_maximizado();
    callback trocar_tema(bool);
    callback trocar_idioma(string);

    // Auto-update
    in-out property <bool> update_disponivel: false;
    in property <string> update_versao: "";
    in property <string> update_descricao: "";
    in-out property <bool> atualizando: false;
    callback baixar_atualizacao();

    // Altura de cada linha da playlist
    private property <length> altura_linha: 30px;
    private property <length> largura_aba: 150px;
    private property <length> altura_letra_linha: 32px;
    private property <length> altura_barra: 34px;
    /// Abas especiais (favoritas, mais tocadas) vêm primeiro, só com ícone
    private property <int> especiais: 2;
    private property <length> largura_especial: 40px;
    private property <[string]> opcoes_ordem: [I18n.sort_default, I18n.sort_title, I18n.sort_artist, I18n.sort_album, I18n.sort_duration, I18n.sort_added, I18n.sort_plays];

    // Mantém a linha selecionada dentro da área visível da lista
    function manter_visivel() {
        if (indice_selecionado >= 0) {
            if (indice_selecionado * altura_linha < lista.content-y) {
                lista.content-y = indice_selecionado * altura_linha;
            } else if ((indice_selecionado + 1) * altura_linha > lista.content-y + lista.height) {
                lista.content-y = (indice_selecionado + 1) * altura_linha - lista.height;
            }
        }
    }

    // Atalhos de teclado. Sem filhos e sem tamanho: existe só para receber o
    // foco (via `forward-focus` e `atalhos.focus()`) e tratar o teclado.
    atalhos := FocusScope {
        key-pressed(event) => {
            // Enquanto o usuário digita na busca, as teclas pertencem ao campo
            if (busca.tem_foco) {
                return reject;
            }

            if (event.text == Key.Escape && info_aberta) {
                info_aberta = false;
                return accept;
            } else if (event.text == Key.Escape && config_aberta) {
                config_aberta = false;
                return accept;
            } else if (event.text == "i" || event.text == "I") {
                abrir_info();
                return accept;
            } else if (event.text == Key.F11) {
                alternar_imersivo();
                return accept;
            } else if (event.text == Key.Escape && modo_imersivo) {
                // Esc em camadas: configurações, painel, só letra, e sai
                if (imv_config_aberta) {
                    imv_config_aberta = false;
                } else if (imv_painel_aberto) {
                    imv_painel_aberto = false;
                } else if (imv_so_letra) {
                    imv_so_letra = false;
                } else {
                    alternar_imersivo();
                }
                return accept;
            } else if (modo_imersivo && (event.text == "l" || event.text == "L")) {
                imv_painel_aberto = !imv_painel_aberto;
                return accept;
            } else if (modo_imersivo && event.text == "/") {
                imv_painel_aberto = true;
                imv_pedido_busca += 1;
                return accept;
            } else if (event.text == "m" || event.text == "M") {
                alternar_mini();
                return accept;
            } else if (event.text == "f" || event.text == "F") {
                alternar_favorita_atual();
                return accept;
            } else if (modo_imersivo && (event.text == "h" || event.text == "H")) {
                imv_so_letra = !imv_so_letra;
                return accept;
            } else if (modo_imersivo && !imv_painel_aberto && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Return)) {
                // Sem o painel não há lista à vista para navegar
                return reject;
            } else if (event.text == Key.Space) {
                play_pause();
                return accept;
            } else if (event.text == Key.LeftArrow) {
                seek_relativo(-5);
                return accept;
            } else if (event.text == Key.RightArrow) {
                seek_relativo(5);
                return accept;
            } else if (event.text == Key.UpArrow) {
                if (musicas.length > 0) {
                    if (indice_selecionado < 0) {
                        indice_selecionado = 0;
                    } else if (indice_selecionado < 1) {
                        indice_selecionado = musicas.length - 1;
                    } else {
                        indice_selecionado -= 1;
                    }
                }
                manter_visivel();
                imv_pedido_rolar += 1;
                return accept;
            } else if (event.text == Key.DownArrow) {
                if (musicas.length > 0) {
                    if (indice_selecionado < 0) {
                        indice_selecionado = 0;
                    } else if (indice_selecionado >= musicas.length - 1) {
                        indice_selecionado = 0;
                    } else {
                        indice_selecionado += 1;
                    }
                }
                manter_visivel();
                imv_pedido_rolar += 1;
                return accept;
            } else if (event.text == Key.Return) {
                if (indice_selecionado >= 0) {
                    musica_selecionada(indice_selecionado);
                }
                return accept;
            }
            return reject;
        }
    }

    // Interface normal: some no modo imersivo (não pinta nem por baixo)
    Rectangle {
        visible: !modo_imersivo && !modo_mini;

        // -------------------------------------------------------------
        // Barra de título customizada
        // -------------------------------------------------------------
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: altura_barra;
            background: Tema.barra;

            // O Windows faz o arraste (com Aero Snap de graça)
            WindowMoveArea {
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("assets/furinar_icon_quadrado.png");
                        // A fonte pode não ser quadrada: recorta mantendo a proporção
                        image-fit: contain;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        text: I18n.app_name;
                        color: Tema.texto;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    BotaoTitulo {
                        icone: @image-url("icons/mini.svg");
                        dica: I18n.tip_mini;
                        clicado => { alternar_mini(); }
                    }
                    BotaoTitulo {
                        icone: @image-url("icons/minimizar.svg");
                        dica: I18n.tip_minimize;
                        clicado => { minimizar(); }
                    }
                    BotaoTitulo {
                        icone: @image-url("icons/x.svg");
                        dica: I18n.tip_close;
                        perigo: true;
                        clicado => { fecha_janela(); }
                    }
                }
            }
        }

        VerticalLayout {
            // Abaixo da barra de título
            y: altura_barra;
            height: parent.height - altura_barra;
            padding: 18px;
            spacing: 14px;

            // -------------------------------------------------------------
            // Controles: transportes à esquerda, modos à direita
            // -------------------------------------------------------------
            HorizontalLayout {
                spacing: 8px;
                height: 52px;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    BotaoIcone {
                        icone: @image-url("icons/abrir.svg");
                        dica: I18n.tip_open_folder;
                        clicado => { abrir_pasta(); }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/anterior.svg");
                        dica: I18n.tip_previous;
                        clicado => { anterior(); }
                    }
                    BotaoIcone {
                        icone: tocando ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                        dica: texto_play_pause;
                        destaque: true;
                        clicado => { play_pause(); }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/stop.svg");
                        dica: I18n.tip_stop;
                        clicado => { parar(); }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/proxima.svg");
                        dica: I18n.tip_next;
                        clicado => { proxima(); }
                    }
                }

                // Espaçador: empurra os modos para a direita
                Rectangle { horizontal-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    BotaoIcone {
                        icone: loop_modo == 1 ? @image-url("icons/loop_faixa.svg") : @image-url("icons/loop.svg");
                        dica: texto_loop;
                        ativo: loop_modo != 0;
                        apagado: loop_modo == 0;
                        clicado => { alternar_loop(); }
                    }
                    BotaoIcone {
                        // Inteligente = baralho embaralhado (cada uma uma
                        // vez); aleatório = dado (pode repetir)
                        icone: shuffle_modo == 1 ? @image-url("icons/dado.svg") : @image-url("icons/shuffle.svg");
                        dica: texto_shuffle;
                        ativo: shuffle_modo != 0;
                        apagado: shuffle_modo == 0;
                        clicado => { alternar_shuffle(); }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/letra.svg");
                        dica: I18n.tip_lyrics;
                        ativo: mostrar_letra;
                        clicado => { mostrar_letra = !mostrar_letra; }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/info.svg");
                        dica: I18n.tip_info;
                        clicado => { abrir_info(); }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/lua.svg");
                        dica: sono_texto != "" ? I18n.tip_sleep + " · " + sono_texto : I18n.tip_sleep;
                        ativo: sono_texto != "";
                        clicado => { alternar_sono(); }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/tela_cheia.svg");
                        dica: I18n.tip_immersive;
                        clicado => { alternar_imersivo(); }
                    }
                    BotaoIcone {
                        icone: @image-url("icons/config.svg");
                        dica: I18n.tip_settings;
                        clicado => { config_aberta = true; }
                    }
                }
            }

            // -------------------------------------------------------------
            // Sliders: volume, progresso e tempo
            // -------------------------------------------------------------
            HorizontalLayout {
                spacing: 12px;
                height: 26px;
                cross-axis-alignment: center;

                BarraDeslizante {
                    width: 110px;
                    valor <=> volume;
                    mudou(v) => { volume_mudou(v); }
                }
                BarraDeslizante {
                    width: sono_texto != "" ? 280px : 340px;
                    valor <=> progresso;
                    ao_vivo: false;
                    mudou(v) => { progresso_mudou(v); }
                }
                Text {
                    text: texto_tempo;
                    color: Tema.texto_suave;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if sono_texto != "" : HorizontalLayout {
                    spacing: 4px;

                    Image {
                        source: @image-url("icons/lua.svg");
                        width: 13px;
                        height: 13px;
                        y: (parent.height - self.height) / 2;
                        colorize: Tema.dourado;
                    }
                    Text {
                        text: sono_texto;
                        color: Tema.dourado;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }

            // -------------------------------------------------------------
            // Busca
            // -------------------------------------------------------------
            linha_busca := HorizontalLayout {
                spacing: 8px;

                busca := CampoBusca {
                    texto <=> texto_busca;
                    placeholder: I18n.search_placeholder;
                    editado(t) => { busca_mudou(t); }
                    // Enter na busca devolve o foco aos atalhos
                    aceito(t) => { atalhos.focus(); }
                }
                botao_ordem := BotaoIcone {
                    height: 38px;
                    icone: @image-url("icons/ordenar.svg");
                    dica: I18n.tip_sort + ": " + opcoes_ordem[ordem_atual];
                    ativo: ordem_atual != 0;
                    clicado => { menu_ordem.show(); }
                }
            }

            menu_ordem := PopupWindow {
                x: linha_busca.x + botao_ordem.x + botao_ordem.width - 220px;
                y: linha_busca.y + botao_ordem.height + 4px;
                width: 220px;

                Rectangle {
                    background: Tema.painel;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Tema.borda;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000050;

                    VerticalLayout {
                        padding: 6px;

                        for nome[i] in opcoes_ordem: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: opcao_toque.has-hover ? Tema.neutro_hover : transparent;

                            opcao_toque := TouchArea {
                                clicked => {
                                    ordem_escolhida(i);
                                    atalhos.focus();
                                }
                            }
                            Text {
                                x: 12px;
                                height: parent.height;
                                text: nome;
                                color: i == ordem_atual ? Tema.oceano : Tema.texto;
                                font-weight: i == ordem_atual ? 700 : 400;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            if i == ordem_atual : Image {
                                source: @image-url("icons/check.svg");
                                x: parent.width - 26px;
                                width: 12px;
                                height: 12px;
                                y: (parent.height - self.height) / 2;
                                colorize: Tema.oceano;
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------------------
            // Abas das pastas. Trocar de aba só muda o que a lista exibe:
            // a reprodução continua na pasta de onde a faixa veio.
            // -------------------------------------------------------------
            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                cross-axis-alignment: center;

                Flickable {
                    horizontal-stretch: 1;
                    height: 32px;
                    content-width: max(0, abas.length - especiais) * (largura_aba + 6px) + min(abas.length, especiais) * (largura_especial + 6px);
                    content-height: 32px;

                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;

                        for nome[i] in abas: Rectangle {
                            width: i < especiais ? largura_especial : largura_aba;
                            height: 32px;
                            border-radius: 8px;
                            background: i == aba_ativa ? Tema.oceano.with-alpha(0.16) : Tema.neutro;
                            border-width: 1px;
                            border-color: i == aba_ativa ? Tema.oceano.with-alpha(0.45) : Tema.borda;
                            clip: true;
                            animate background, border-color { duration: 130ms; }

                            TouchArea {
                                clicked => {
                                    aba_selecionada(i);
                                    atalhos.focus();
                                }
                            }

                            // Sublinhado da aba ativa
                            Rectangle {
                                visible: i == aba_ativa;
                                x: 10px;
                                y: parent.height - 4px;
                                width: parent.width - 20px;
                                height: 2px;
                                border-radius: 1px;
                                background: Tema.oceano;
                            }

                            // Especiais: só o ícone (o nome fica na dica)
                            if i < especiais : Image {
                                source: i == 0 ? @image-url("icons/estrela.svg") : @image-url("icons/tocadas.svg");
                                width: 15px;
                                height: 15px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - 4px - self.height) / 2;
                                colorize: i == aba_ativa ? Tema.dourado : Tema.texto_suave;
                                accessible-role: text;
                                accessible-label: nome;
                            }
                            if i >= especiais : Text {
                                x: 12px;
                                y: 0px;
                                width: parent.width - 50px;
                                height: parent.height - 4px;
                                text: nome;
                                color: i == aba_ativa ? Tema.texto : Tema.texto_suave;
                                font-size: 13px;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            // Pontinho dourado: de onde vem o som agora
                            Rectangle {
                                visible: i == aba_tocando;
                                x: i < especiais ? parent.width - 9px : parent.width - 32px;
                                y: (parent.height - self.height) / 2;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Tema.dourado;
                            }

                            // Fechar: só na aba ativa, para não poluir (as
                            // especiais não fecham)
                            Rectangle {
                                visible: i == aba_ativa && i >= especiais;
                                x: parent.width - 22px;
                                y: 8px;
                                width: 16px;
                                height: 16px;
                                border-radius: 4px;
                                background: transparent;
                                animate background { duration: 120ms; }

                                Image {
                                    source: @image-url("icons/x.svg");
                                    width: 10px;
                                    height: 10px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Tema.texto_suave;
                                }

                                fechar_touch := TouchArea {
                                    clicked => { fechar_aba(i); }
                                }

                                states [
                                    hover when fechar_touch.has-hover : {
                                        background: Tema.neutro_hover;
                                    }
                                ]
                            }
                        }
                    }
                }

                // Abrir mais uma pasta
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: Tema.neutro;
                    border-width: 1px;
                    border-color: Tema.borda;
                    animate background, border-color { duration: 130ms; }

                    Image {
                        source: @image-url("icons/mais.svg");
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Tema.texto;
                    }

                    mais_touch := TouchArea {
                        clicked => {
                            abrir_pasta();
                            atalhos.focus();
                        }
                    }

                    states [
                        hover when mais_touch.has-hover : {
                            background: Tema.neutro_hover;
                            border-color: Tema.oceano.with-alpha(0.42);
                        }
                    ]
                }
            }

            // -------------------------------------------------------------
            // Conteúdo: playlist ou painel de letra, no mesmo espaço
            // -------------------------------------------------------------
            conteudo := Rectangle {
                // Absorve o espaço restante: sem isso o Flickable propaga o tamanho
                // do conteúdo como preferred e o layout estoura a janela.
                vertical-stretch: 1;
                preferred-height: 0px;
                background: Tema.painel_fosco;
                border-radius: 12px;
                border-width: 1px;
                border-color: Tema.borda;
                clip: true;

                lista := Flickable {
                    visible: !mostrar_letra;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-height: musicas.length * altura_linha;

                    VerticalLayout {
                        alignment: start;

                        for musica[i] in musicas: Rectangle {
                            height: altura_linha;
                            background: i == indice_selecionado ? Tema.selecao : transparent;

                            // Barrinha dourada marcando a linha selecionada
                            Rectangle {
                                visible: i == indice_selecionado;
                                x: 0px;
                                y: 5px;
                                width: 3px;
                                height: parent.height - 10px;
                                border-radius: 2px;
                                background: Tema.dourado;
                            }

                            Text {
                                text: musica.texto;
                                color: Tema.texto;
                                font-size: 13px;
                                vertical-alignment: center;
                                x: 14px;
                                width: parent.width - 52px;
                                overflow: elide;
                            }

                            linha_toque := TouchArea {
                                clicked => {
                                    musica_selecionada(i);
                                    // Devolve o foco para os atalhos de teclado
                                    atalhos.focus();
                                }
                            }

                            // Estrela: sempre nas favoritas, no hover nas outras
                            if musica.favorita || linha_toque.has-hover || estrela_toque.has-hover : Image {
                                x: parent.width - 30px;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                source: musica.favorita ? @image-url("icons/estrela_cheia.svg") : @image-url("icons/estrela.svg");
                                colorize: musica.favorita ? Tema.dourado : Tema.texto_suave;
                            }
                            estrela_toque := TouchArea {
                                x: parent.width - 38px;
                                width: 30px;
                                clicked => {
                                    favorita_alternada(i);
                                    atalhos.focus();
                                }
                            }
                        }
                    }
                }

                // Lista especial vazia: diz como ela se enche
                if !mostrar_letra && musicas.length == 0 && aba_ativa < especiais : Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: aba_ativa == 0 ? I18n.favorites_empty : I18n.most_played_empty;
                    color: Tema.texto_suave;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                // Painel de letra: sobrepõe exatamente a área da lista
                painel_letra := Rectangle {
                    visible: mostrar_letra;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    if letra.length == 0 && !letra_livre : VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: painel_letra.width;
                        height: painel_letra.height;
                        alignment: center;
                        padding: 20px;

                        Text {
                            text: I18n.no_lyrics;
                            color: Tema.texto_suave;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // Letra sem tempos: o texto inteiro, rolável
                    if letra_livre : Flickable {
                        x: 0px;
                        y: 0px;
                        width: painel_letra.width;
                        height: painel_letra.height;
                        content-height: livre.preferred-height;

                        livre := VerticalLayout {
                            padding: 18px;
                            spacing: 4px;

                            for linha in letra_completa: Text {
                                text: linha;
                                color: Tema.texto.with-alpha(0.85);
                                font-size: 15px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if letra.length > 0 && !letra_livre : VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: painel_letra.width;
                        height: painel_letra.height;
                        alignment: center;
                        padding: 14px;
                        spacing: 2px;

                        for linha[i] in letra: Rectangle {
                            height: altura_letra_linha;
                            background: transparent;
                            animate background { duration: 120ms; }

                            Text {
                                x: 12px;
                                y: 0px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: linha;
                                color: i == letra_destaque ? Tema.dourado : Tema.texto.with-alpha(0.62);
                                font-size: i == letra_destaque ? 19px : 15px;
                                font-weight: i == letra_destaque ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            // Clicar numa linha pula a música para aquele trecho
                            letra_touch := TouchArea {
                                clicked => { letra_linha_clicada(i); }
                            }

                            states [
                                hover when letra_touch.has-hover : {
                                    background: Tema.oceano.with-alpha(0.10);
                                }
                            ]
                        }
                    }
                }
            }
        }
    }

    if modo_mini : MiniPlayer {
        width: parent.width;
        height: parent.height;
        titulo: mini_titulo;
        artista: mini_artista;
        capa: mini_capa;
        tem_capa: mini_tem_capa;
        tocando: tocando;
        progresso: progresso;
        anterior => { anterior(); }
        play_pause => { play_pause(); }
        proxima => { proxima(); }
        expandir => { alternar_mini(); }
    }

    if modo_imersivo : TelaImersiva {
        width: parent.width;
        height: parent.height;
        fundo_a: imv_fundo_a;
        fundo_b: imv_fundo_b;
        mostra_a: imv_mostra_a;
        tem_fundo: imv_tem_fundo;
        fundo_pixelado: imv_fundo_pixelado;
        capa: imv_capa;
        tem_capa: imv_tem_capa;
        titulo: imv_titulo;
        creditos: imv_creditos;
        tecnico: imv_tecnico;
        cor: imv_tem_cor ? imv_cor : Tema.oceano;
        letra: letra_completa;
        letra_indice: letra_indice;
        barras: imv_barras;
        tocando: tocando;
        loop_modo: loop_modo;
        texto_loop: texto_loop;
        texto_shuffle: texto_shuffle;
        shuffle_modo: shuffle_modo;
        texto_tempo: texto_tempo;
        volume <=> volume;
        progresso <=> progresso;
        sair => { alternar_imersivo(); }
        anterior => { anterior(); }
        play_pause => { play_pause(); }
        proxima => { proxima(); }
        alternar_loop => { alternar_loop(); }
        alternar_shuffle => { alternar_shuffle(); }
        volume_mudou(v) => { volume_mudou(v); }
        progresso_mudou(v) => { progresso_mudou(v); }
        letra_clicada(i) => { letra_completa_clicada(i); }

        painel_aberto <=> imv_painel_aberto;
        abas: abas;
        aba_ativa: aba_ativa;
        aba_tocando: aba_tocando;
        texto_busca <=> texto_busca;
        painel_total: imv_painel_total;
        painel_primeira: imv_painel_primeira;
        painel_linhas: imv_painel_linhas;
        fila: imv_fila;
        selecionado: indice_selecionado;
        pedido_rolar: imv_pedido_rolar;
        pedido_busca: imv_pedido_busca;
        so_letra <=> imv_so_letra;
        relogio: imv_relogio;
        sono: sono_texto;
        letra_livre: letra_livre;
        letra_progresso: imv_letra_progresso;
        favorita: favorita_atual;
        texto_proxima: imv_proxima;
        pulso: imv_pulso;
        albuns: imv_albuns;
        guia <=> imv_guia;
        ordem_atual: ordem_atual;
        opcoes_ordem: opcoes_ordem;
        especiais: especiais;
        alternar_favorita => { alternar_favorita_atual(); }
        favorita_alternada(i) => { favorita_alternada(i); }
        guia_mudou(g) => { imv_guia_mudou(g); }
        albuns_rolou(a, b) => { imv_albuns_rolou(a, b); }
        album_clicado(i) => { imv_album_clicado(i); }
        ordem_escolhida(i) => { ordem_escolhida(i); }
        config_aberta <=> imv_config_aberta;
        ocioso <=> imv_ocioso;
        crossfade_texto: crossfade_texto;
        replaygain <=> replaygain;
        fundo_reativo <=> fundo_reativo;
        fundo_global_nome: fundo_global_nome;
        alternar_crossfade => { alternar_crossfade(); }
        alternar_replaygain(v) => { alternar_replaygain(v); }
        alternar_fundo_reativo(v) => { alternar_fundo_reativo(v); }
        escolher_fundo => { escolher_fundo(); }
        limpar_fundo => { limpar_fundo(); }
        abrir_info => { abrir_info(); }
        letras_web <=> letras_web;
        discord <=> discord;
        alternar_discord(v) => { alternar_discord(v); }
        listenbrainz_token <=> listenbrainz_token;
        lastfm_chave <=> lastfm_chave;
        lastfm_segredo <=> lastfm_segredo;
        lastfm_conectado: lastfm_conectado;
        lastfm_aguardando: lastfm_aguardando;
        lastfm_estado: lastfm_estado;
        scrobble_estado: scrobble_estado;
        listenbrainz_mudou(t) => { listenbrainz_mudou(t); }
        lastfm_credenciais_mudou(a, b) => { lastfm_credenciais_mudou(a, b); }
        lastfm_conectar => { lastfm_conectar(); }
        lastfm_concluir => { lastfm_concluir(); }
        lastfm_desconectar => { lastfm_desconectar(); }
        chave_acoustid <=> chave_acoustid;
        alternar_letras_web(v) => { alternar_letras_web(v); }
        chave_acoustid_mudou(c) => { chave_acoustid_mudou(c); }
        painel_alternado(aberto) => { imv_painel_alternado(aberto); }
        aba_selecionada(i) => { aba_selecionada(i); }
        busca_mudou(t) => { busca_mudou(t); }
        painel_rolou(a, b) => { imv_painel_rolou(a, b); }
        linha_clicada(i) => { musica_selecionada(i); }
        fila_clicada(i) => { imv_fila_clicada(i); }
        devolver_foco => { atalhos.focus(); }
        alternar_sono => { alternar_sono(); }
    }

    JanelaInfo {
        width: parent.width;
        height: parent.height;
        aberta <=> info_aberta;
        guia <=> info_guia;
        imersivo: modo_imersivo;
        cor_imersivo: imv_tem_cor ? imv_cor : Tema.oceano;
        titulo: info_titulo;
        artista: info_artista;
        album: info_album;
        corrigida: info_corrigida;
        letra: info_letra;
        estado: info_estado;
        ocupado: info_ocupado;
        candidatos: info_candidatos;
        lote_ativo: lote_ativo;
        lote_progresso: lote_progresso;
        lote_texto: lote_texto;
        revisao: revisao;
        tags_texto: tags_texto;
        buscar => { info_buscar(); }
        aplicar(i, gravar) => { info_aplicar(i, gravar); }
        restaurar => { info_restaurar(); }
        baixar_letra => { info_baixar_letra(); }
        lote_iniciar => { lote_iniciar(); }
        lote_cancelar => { lote_cancelar(); }
        revisao_decidir(i, aceitar) => { revisao_decidir(i, aceitar); }
        gravar_tags_aba => { gravar_tags_aba(); }
        changed aberta => {
            if (!self.aberta) {
                atalhos.focus();
            }
        }
    }

    // -------------------------------------------------------------
    // Configurações
    // -------------------------------------------------------------
    update_popup := PopupWindow {
        x: 170px;
        y: 200px;

        Rectangle {
            visible: update_disponivel;
            background: Tema.painel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Tema.borda;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: I18n.update_title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Tema.texto;
                }

                Text {
                    text: "v" + update_versao;
                    font-size: 14px;
                    color: Tema.oceano;
                    font-weight: 600;
                }

                Text {
                    text: update_descricao;
                    font-size: 12px;
                    color: Tema.texto_suave;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 80px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 120px;
                        height: 32px;
                        border-radius: 8px;
                        background: Tema.oceano;
                        TouchArea {
                            clicked => { baixar_atualizacao(); }
                        }
                        Text {
                            text: atualizando ? I18n.update_downloading : I18n.update_button;
                            color: white;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 80px;
                        height: 32px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Tema.borda;
                        background: Tema.painel;
                        TouchArea {
                            clicked => { update_disponivel = false; }
                        }
                        Text {
                            text: I18n.update_later;
                            color: Tema.texto;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Cartão sobre a janela (não PopupWindow): mexer numa opção não fecha,
    // clique fora e Esc fecham, e rola quando não cabe
    if config_aberta : Rectangle {
        background: #00000060;

        TouchArea {
            clicked => {
                config_aberta = false;
                atalhos.focus();
            }
        }

        Rectangle {
            width: 420px;
            height: min(parent.height - 60px, conteudo_config.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tema.painel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Tema.borda;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;
            clip: true;

            // Engole o clique para não fechar
            TouchArea { }

            Flickable {
                content-height: conteudo_config.preferred-height;

                conteudo_config := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        Text {
                            text: I18n.config_title;
                            font-size: 16px;
                            font-weight: 700;
                            color: Tema.texto;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        BotaoTitulo {
                            icone: @image-url("icons/x.svg");
                            dica: I18n.tip_close;
                            clicado => {
                                config_aberta = false;
                                atalhos.focus();
                            }
                        }
                    }

                    CaixaSelecao {
                        rotulo: tema_escuro ? I18n.theme_dark : I18n.theme_light;
                        marcado <=> tema_escuro;
                        alternado(v) => { trocar_tema(v); }
                    }

                    CaixaSelecao {
                        rotulo: I18n.scan_subfolders;
                        marcado <=> escanear_subpastas;
                        alternado(v) => { alternar_escanear_subpastas(v); }
                    }

                    Text {
                        text: I18n.scan_subfolders_desc;
                        font-size: 12px;
                        color: Tema.texto_suave;
                        wrap: word-wrap;
                    }

                    CaixaSelecao {
                        rotulo: I18n.replaygain;
                        marcado <=> replaygain;
                        alternado(v) => { alternar_replaygain(v); }
                    }
                    Text {
                        text: I18n.replaygain_desc;
                        font-size: 12px;
                        color: Tema.texto_suave;
                        wrap: word-wrap;
                    }

                    // Crossfade: cada clique passa para a próxima duração
                    Rectangle {
                        height: 30px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Tema.borda;
                        background: ta_crossfade.has-hover ? Tema.neutro_hover : Tema.neutro;
                        animate background { duration: 120ms; }

                        ta_crossfade := TouchArea {
                            clicked => { alternar_crossfade(); }
                        }
                        Text {
                            text: crossfade_texto;
                            color: Tema.texto;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    CaixaSelecao {
                        rotulo: I18n.reactive_bg;
                        marcado <=> fundo_reativo;
                        alternado(v) => { alternar_fundo_reativo(v); }
                    }

                    CaixaSelecao {
                        rotulo: I18n.discord_status;
                        marcado <=> discord;
                        alternado(v) => { alternar_discord(v); }
                    }

                    CaixaSelecao {
                        rotulo: I18n.lyrics_web;
                        marcado <=> letras_web;
                        alternado(v) => { alternar_letras_web(v); }
                    }
                    Text {
                        text: I18n.lyrics_web_desc;
                        font-size: 12px;
                        color: Tema.texto_suave;
                        wrap: word-wrap;
                    }

                    // Chave do AcoustID (impressão digital)
                    Text {
                        text: I18n.acoustid_key;
                        color: Tema.texto;
                        font-size: 14px;
                    }
                    Rectangle {
                        height: 30px;
                        border-radius: 8px;
                        background: Tema.neutro;
                        border-width: 1px;
                        border-color: campo_chave.has-focus ? Tema.foco : Tema.borda;

                        campo_chave := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            color: Tema.texto;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            text <=> chave_acoustid;
                            edited => { chave_acoustid_mudou(self.text); }
                            accepted => { atalhos.focus(); }
                        }
                    }
                    Text {
                        text: I18n.acoustid_desc;
                        font-size: 12px;
                        color: Tema.texto_suave;
                        wrap: word-wrap;
                    }

                    // Scrobble
                    Text {
                        text: I18n.scrobble_title;
                        color: Tema.texto;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    Text {
                        text: I18n.listenbrainz_token;
                        color: Tema.texto;
                        font-size: 13px;
                    }
                    CampoTexto {
                        texto <=> listenbrainz_token;
                        senha: true;
                        editado(t) => { listenbrainz_mudou(t); }
                        aceito => { atalhos.focus(); }
                    }
                    Text {
                        text: I18n.lastfm_keys;
                        color: Tema.texto;
                        font-size: 13px;
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        CampoTexto {
                            texto <=> lastfm_chave;
                            placeholder: I18n.lastfm_key;
                            editado(t) => { lastfm_credenciais_mudou(t, lastfm_segredo); }
                            aceito => { atalhos.focus(); }
                        }
                        CampoTexto {
                            texto <=> lastfm_segredo;
                            placeholder: I18n.lastfm_secret;
                            senha: true;
                            editado(t) => { lastfm_credenciais_mudou(lastfm_chave, t); }
                            aceito => { atalhos.focus(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        BotaoTexto {
                            texto: lastfm_conectado ? I18n.lastfm_disconnect : (lastfm_aguardando ? I18n.lastfm_finish : I18n.lastfm_connect);
                            clicado => {
                                if (lastfm_conectado) {
                                    lastfm_desconectar();
                                } else if (lastfm_aguardando) {
                                    lastfm_concluir();
                                } else {
                                    lastfm_conectar();
                                }
                            }
                        }
                        Text {
                            text: lastfm_estado;
                            color: Tema.texto_suave;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: scrobble_estado != "" ? scrobble_estado : I18n.scrobble_desc;
                        font-size: 12px;
                        color: Tema.texto_suave;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        width: 100%;
                        height: 32px;
                        border-radius: 8px;
                        background: ta_lang.has-hover ? Tema.neutro_hover : transparent;
                        animate background { duration: 120ms; }

                        ta_lang := TouchArea {
                            clicked => { trocar_idioma(I18n.idioma == "en" ? "pt-br" : "en"); }
                        }

                        Text {
                            text: I18n.idioma == "en" ? "Idioma: Português" : "Language: English";
                            color: Tema.texto;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Fundo do modo imersivo
                    Text {
                        text: I18n.bg_label;
                        color: Tema.texto;
                        font-size: 14px;
                    }
                    Text {
                        text: fundo_global_nome != "" ? fundo_global_nome : I18n.bg_none;
                        color: Tema.texto_suave;
                        font-size: 12px;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        for botao[i] in [I18n.bg_choose, I18n.bg_clear]: Rectangle {
                            visible: i == 0 || fundo_global_nome != "";
                            height: 30px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Tema.borda;
                            background: ta_fundo.has-hover ? Tema.neutro_hover : Tema.neutro;
                            animate background { duration: 120ms; }

                            ta_fundo := TouchArea {
                                clicked => {
                                    if (i == 0) {
                                        escolher_fundo();
                                    } else {
                                        limpar_fundo();
                                    }
                                }
                            }
                            Text {
                                text: botao;
                                color: Tema.texto;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

export { I18n, LinhaPainel, CartaoAlbum, CandidatoInfo, ItemRevisao }
