import { Button, Slider, CheckBox, LineEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Furinar Audio Player";
    width: 660px;
    height: 700px;
    background: #16161a;

    // Foco inicial vai para o FocusScope dos atalhos de teclado
    forward-focus: atalhos;

    in-out property <string> texto_play_pause: "Play";
    in-out property <string> texto_busca: "";
    in-out property <string> texto_loop: "Loop: Desl";
    in-out property <string> texto_shuffle: "Shuffle: Desl";
    in-out property <float> volume: 0.8;
    in-out property <float> progresso: 0.0;
    in-out property <string> texto_tempo: "00:00 / 00:00";
    in property <[string]> musicas: [];
    in-out property <int> indice_selecionado: -1;
    in-out property <bool> escanear_subpastas: false;

    callback abrir_pasta();
    callback anterior();
    callback play_pause();
    callback parar();
    callback proxima();
    callback alternar_loop();
    callback alternar_shuffle();
    callback volume_mudou(float);
    callback progresso_mudou(float);
    callback seek_relativo(int);
    callback musica_selecionada(int);
    callback busca_mudou(string);
    callback fecha_janela();
    callback alternar_escanear_subpastas(bool);

    // Mantém a linha selecionada dentro da área visível da lista
    function manter_visivel() {
        if (indice_selecionado >= 0) {
            if (indice_selecionado * 24px < lista.content-y) {
                lista.content-y = indice_selecionado * 24px;
            } else if ((indice_selecionado + 1) * 24px > lista.content-y + lista.height) {
                lista.content-y = (indice_selecionado + 1) * 24px - lista.height;
            }
        }
    }

    // Atalhos de teclado. Sem filhos e sem tamanho: existe só para receber o
    // foco (via `forward-focus` e `atalhos.focus()`) e tratar o teclado.
    atalhos := FocusScope {
        key-pressed(event) => {
            // Enquanto o usuário digita na busca, as teclas pertencem ao campo
            if (campo_busca.has-focus) {
                return reject;
            }

            if (event.text == Key.Space) {
                play_pause();
                return accept;
            } else if (event.text == Key.LeftArrow) {
                seek_relativo(-5);
                return accept;
            } else if (event.text == Key.RightArrow) {
                seek_relativo(5);
                return accept;
            } else if (event.text == Key.UpArrow) {
                if (musicas.length > 0) {
                    if (indice_selecionado < 0) {
                        indice_selecionado = 0;
                    } else if (indice_selecionado < 1) {
                        indice_selecionado = musicas.length - 1;
                    } else {
                        indice_selecionado -= 1;
                    }
                }
                manter_visivel();
                return accept;
            } else if (event.text == Key.DownArrow) {
                if (musicas.length > 0) {
                    if (indice_selecionado < 0) {
                        indice_selecionado = 0;
                    } else if (indice_selecionado >= musicas.length - 1) {
                        indice_selecionado = 0;
                    } else {
                        indice_selecionado += 1;
                    }
                }
                manter_visivel();
                return accept;
            } else if (event.text == Key.Return) {
                if (indice_selecionado >= 0) {
                    musica_selecionada(indice_selecionado);
                }
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            height: 44px;

            Button {
                text: "Abrir";
                clicked => { abrir_pasta(); }
            }
            Button {
                text: "Ant";
                clicked => { anterior(); }
            }
            Button {
                text: texto_play_pause;
                clicked => { play_pause(); }
            }
            Button {
                text: "Stop";
                clicked => { parar(); }
            }
            Button {
                text: "Prox";
                clicked => { proxima(); }
            }
            Button {
                text: texto_loop;
                clicked => { alternar_loop(); }
            }
            Button {
                text: texto_shuffle;
                clicked => { alternar_shuffle(); }
            }
            Button {
                text: "Config";
                clicked => { config_popup.show(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            height: 28px;

            Slider {
                width: 120px;
                minimum: 0;
                maximum: 1;
                value <=> volume;
                changed(v) => { volume_mudou(v); }
            }
            Slider {
                width: 360px;
                minimum: 0;
                maximum: 1;
                value <=> progresso;
                changed(v) => { progresso_mudou(v); }
            }
            Text {
                text: texto_tempo;
                color: #e8e8ec;
                vertical-alignment: center;
            }
        }

        campo_busca := LineEdit {
            height: 32px;
            placeholder-text: "Buscar por título ou artista...";
            text <=> texto_busca;
            edited(t) => { busca_mudou(t); }
            // Enter na busca devolve o foco aos atalhos
            accepted(t) => { atalhos.focus(); }
        }

        Rectangle {
            background: #201e24;
            border-radius: 6px;
            clip: true;

            lista := Flickable {
                content-height: musicas.length * 24px;

                VerticalLayout {
                    alignment: start;

                    for musica[i] in musicas: Rectangle {
                        height: 24px;
                        background: i == indice_selecionado ? #5a5df0 : transparent;

                        Text {
                            text: musica;
                            color: #e8e8ec;
                            vertical-alignment: center;
                            x: 8px;
                        }

                        TouchArea {
                            clicked => {
                                musica_selecionada(i);
                                // Devolve o foco para os atalhos de teclado
                                atalhos.focus();
                            }
                        }
                    }
                }
            }
        }
    }

    config_popup := PopupWindow {
        x: 170px;
        y: 265px;

        Rectangle {
            background: #201e24;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3a3a40;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "Configurações";
                    font-size: 16px;
                    font-weight: 700;
                    color: #e8e8ec;
                }

                CheckBox {
                    text: "Escaneia subpastas";
                    checked <=> escanear_subpastas;
                    toggled => { alternar_escanear_subpastas(self.checked); }
                }

                Text {
                    text: "Inclui arquivos de áudio de subpastas ao abrir uma pasta.";
                    font-size: 12px;
                    color: #9a9aa0;
                    wrap: word-wrap;
                }
            }
        }
    }
}