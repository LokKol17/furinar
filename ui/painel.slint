// ---------------------------------------------------------------------
// Painel da biblioteca do modo imersivo
//
// Gaveta à direita com as abas das pastas, a busca, a lista da aba visível,
// a fila "a seguir" e a grade de álbuns. A lista é virtualizada pelo Rust:
// chegam só as linhas ao redor do trecho visível (`linhas`, começando em
// `primeira`), e o painel avisa quando rola (`rolou`). A grade recebe todos
// os cartões, mas só os à vista têm imagem (`albuns_rolou`).
// ---------------------------------------------------------------------

import { I18n } from "i18n.slint";

export struct LinhaPainel {
    titulo: string,
    detalhe: string,
    duracao: string,
    capa: image,
    tem_capa: bool,
    tocando: bool,
    favorita: bool,
    /// Arquivo de vídeo: selo no canto da capa
    video: bool,
}

export struct CartaoAlbum {
    nome: string,
    detalhe: string,
    capa: image,
    tem_capa: bool,
}

component Linha inherits Rectangle {
    in property <LinhaPainel> dados;
    in property <bool> selecionada: false;
    in property <color> cor;
    in property <[float]> barras: [];
    /// Linha da lista (na fila a estrela só aparece, não alterna)
    in property <bool> com_estrela: true;
    callback clicado();
    callback estrela();

    height: 56px;
    border-radius: 8px;
    background: root.dados.tocando ? root.cor.with-alpha(0.20) : (root.selecionada ? #ffffff1f : (toque.has-hover ? #ffffff12 : transparent));
    animate background { duration: 120ms; }

    toque := TouchArea {
        clicked => { root.clicado(); }
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: 40px;
        height: 40px;
        border-radius: 5px;
        clip: true;
        background: root.cor.with-alpha(0.30);

        if root.dados.tem_capa : Image {
            width: parent.width;
            height: parent.height;
            source: root.dados.capa;
            image-fit: cover;
        }
        if !root.dados.tem_capa : Image {
            source: @image-url("icons/letra.svg");
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: #ffffff80;
        }

        // Vídeo: selo no canto da capa (some enquanto toca, sob o equalizador)
        if root.dados.video && !root.dados.tocando : Rectangle {
            x: parent.width - self.width - 2px;
            y: parent.height - self.height - 2px;
            width: 18px;
            height: 14px;
            border-radius: 3px;
            background: #000000b0;

            Image {
                width: 11px;
                height: 11px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/video.svg");
                colorize: #ffffff;
            }
        }

        // Tocando: mini equalizador sobre a capa, puxado do visualizador
        if root.dados.tocando : Rectangle {
            background: #00000088;

            for k in 3 : Rectangle {
                x: 9px + k * 8px;
                width: 5px;
                height: max(3px, root.barras[4 + k * 9] * 24px);
                y: parent.height - 8px - self.height;
                border-radius: 1px;
                background: #ffffff;
            }
        }
    }

    VerticalLayout {
        x: 60px;
        width: root.width - self.x - 88px;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.dados.titulo;
            color: root.dados.tocando ? root.cor : #ffffff;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
        // `if`, não `visible`: escondido ainda ocuparia espaço no layout
        if root.dados.detalhe != "" : Text {
            text: root.dados.detalhe;
            color: #ffffff8c;
            font-size: 12px;
            overflow: elide;
        }
    }

    if root.dados.favorita || (root.com_estrela && (toque.has-hover || estrela_toque.has-hover)) : Image {
        x: root.width - 76px;
        y: (root.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: root.dados.favorita ? @image-url("icons/estrela_cheia.svg") : @image-url("icons/estrela.svg");
        colorize: root.dados.favorita ? root.cor : #ffffff80;
    }
    estrela_toque := TouchArea {
        x: root.width - 84px;
        width: 30px;
        enabled: root.com_estrela;
        clicked => { root.estrela(); }
    }

    Text {
        x: root.width - 56px;
        width: 46px;
        height: root.height;
        text: root.dados.duracao;
        color: #ffffff80;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Botão de texto do cabeçalho (guias "Biblioteca" / "A seguir")
component Guia inherits Rectangle {
    in property <string> texto;
    in property <bool> ativa;
    in property <color> cor;
    callback clicado();

    height: 32px;
    width: rotulo.preferred-width + 24px;
    border-radius: 16px;
    background: root.ativa ? #ffffff24 : (toque.has-hover ? #ffffff12 : transparent);
    animate background { duration: 120ms; }

    rotulo := Text {
        text: root.texto;
        color: root.ativa ? #ffffff : #ffffffa0;
        font-size: 14px;
        font-weight: root.ativa ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    toque := TouchArea {
        clicked => { root.clicado(); }
    }
}

export component PainelBiblioteca inherits Rectangle {
    in property <[string]> abas;
    in property <int> aba_ativa;
    in property <int> aba_tocando: -1;
    in-out property <string> texto_busca;
    in property <int> total;
    in property <int> primeira;
    in property <[LinhaPainel]> linhas;
    in property <[LinhaPainel]> fila;
    in property <int> selecionado: -1;
    /// Incrementados pela janela: navegar pelo teclado / foco na busca
    in property <int> pedido_rolar;
    in property <int> pedido_busca;
    in property <color> cor;
    in property <[float]> barras;
    in property <[CartaoAlbum]> albuns;
    /// 0 = biblioteca, 1 = a seguir, 2 = álbuns
    in-out property <int> guia: 0;
    in property <int> ordem_atual;
    in property <[string]> opcoes_ordem;
    /// Filtro de tipo (0 tudo, 1 só áudio, 2 só vídeo) e suas opções; só
    /// aparece em aba com vídeo
    in property <int> midia_atual;
    in property <[string]> opcoes_midia;
    in property <bool> aba_tem_video;
    /// Abas especiais no começo (favoritas, mais tocadas)
    in property <int> especiais;

    callback guia_mudou(int);
    callback albuns_rolou(int, int);
    callback album_clicado(int);
    callback ordem_escolhida(int);
    callback midia_escolhida(int);
    callback favorita_alternada(int);
    callback aba_selecionada(int);
    callback busca_mudou(string);
    callback rolou(int, int);
    callback linha_clicada(int);
    callback fila_clicada(int);
    callback devolver_foco();
    callback fechar();

    property <length> passo: 60px;
    // Grade: três colunas de cartões
    property <int> colunas: 3;
    property <length> vao: 12px;
    property <length> largura_cartao: (grade.width - (root.colunas - 1) * root.vao) / root.colunas;
    property <length> altura_cartao: root.largura_cartao + 48px;

    changed guia => {
        root.guia_mudou(root.guia);
        if (root.guia == 2) {
            root.informar_grade();
        }
    }

    function informar_grade() {
        root.albuns_rolou(
            max(0, floor(-grade.content-y / (root.altura_cartao + root.vao))) * root.colunas,
            (ceil(grade.height / (root.altura_cartao + root.vao)) + 1) * root.colunas);
    }

    background: #0a0e15eb;

    function informar() {
        root.rolou(max(0, floor(-lista.content-y / root.passo)), ceil(lista.height / root.passo));
    }

    function rolar_para(y: length) {
        lista.content-y = max(min(0px, lista.height - root.total * root.passo), min(0px, y));
        root.informar();
    }

    // Linha selecionada no centro (ao abrir)
    function centralizar() {
        if (root.selecionado >= 0) {
            root.rolar_para(lista.height / 2 - (root.selecionado + 0.5) * root.passo);
        } else {
            root.informar();
        }
    }

    // Só rola o necessário para a seleção aparecer (teclado)
    function manter_visivel() {
        if (root.selecionado < 0) {
            return;
        }
        if (root.selecionado * root.passo < -lista.content-y) {
            root.rolar_para(-root.selecionado * root.passo);
        } else if ((root.selecionado + 1) * root.passo > -lista.content-y + lista.height) {
            root.rolar_para(lista.height - (root.selecionado + 1) * root.passo);
        }
    }

    /// Chamado pela tela depois de avisar o Rust que o painel abriu: a
    /// primeira rolagem informada já encontra o painel do lado de lá.
    public function abrir() {
        root.guia = 0;
        root.centralizar();
    }
    changed albuns => {
        if (root.guia == 2) {
            root.informar_grade();
        }
    }
    changed pedido_rolar => {
        root.guia = 0;
        root.manter_visivel();
    }
    changed pedido_busca => {
        root.guia = 0;
        entrada.focus();
    }

    // Engole cliques e rolagem que caíssem na tela de trás
    TouchArea { }

    // Borda esquerda
    Rectangle {
        x: 0px;
        width: 1px;
        background: #ffffff1a;
    }

    // -------------------------------------------------------------
    // Cabeçalho
    // -------------------------------------------------------------
    HorizontalLayout {
        x: 20px;
        y: 20px;
        width: root.width - 40px;
        height: 32px;
        spacing: 6px;

        Guia {
            texto: I18n.library_title;
            ativa: root.guia == 0;
            cor: root.cor;
            clicado => { root.guia = 0; }
        }
        Guia {
            texto: I18n.up_next;
            ativa: root.guia == 1;
            cor: root.cor;
            clicado => { root.guia = 1; }
        }
        Guia {
            texto: I18n.albums;
            ativa: root.guia == 2;
            cor: root.cor;
            clicado => { root.guia = 2; }
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: 32px;
            border-radius: 16px;
            background: fechar_toque.has-hover ? #ffffff26 : transparent;
            animate background { duration: 120ms; }

            Image {
                source: @image-url("icons/x.svg");
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffffcc;
            }
            fechar_toque := TouchArea {
                clicked => { root.fechar(); }
            }
        }
    }

    // -------------------------------------------------------------
    // Biblioteca: abas, busca e lista
    // -------------------------------------------------------------
    Rectangle {
        y: 64px;
        height: root.height - self.y;
        visible: root.guia != 1;

        Flickable {
            x: 20px;
            y: 0px;
            width: root.width - 40px;
            height: 32px;
            content-width: max(self.width, chips.preferred-width);

            chips := HorizontalLayout {
                alignment: start;
                spacing: 6px;

                for nome[i] in root.abas: Rectangle {
                    height: 32px;
                    width: i < root.especiais
                        ? (i == root.aba_tocando ? 50px : 38px)
                        : min(180px, chip_texto.preferred-width + (i == root.aba_tocando ? 40px : 28px));
                    border-radius: 16px;
                    background: i == root.aba_ativa ? root.cor.with-alpha(0.28) : (chip_toque.has-hover ? #ffffff1a : #ffffff0d);
                    border-width: 1px;
                    border-color: i == root.aba_ativa ? root.cor.with-alpha(0.7) : #ffffff1a;
                    animate background, border-color { duration: 130ms; }

                    if i < root.especiais : Image {
                        source: i == 0 ? @image-url("icons/estrela.svg") : @image-url("icons/tocadas.svg");
                        x: 12px;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        colorize: i == root.aba_ativa ? #ffffff : #ffffffb0;
                        accessible-role: text;
                        accessible-label: nome;
                    }
                    chip_texto := Text {
                        visible: i >= root.especiais;
                        x: 14px;
                        width: parent.width - (i == root.aba_tocando ? 40px : 28px);
                        height: parent.height;
                        text: nome;
                        color: i == root.aba_ativa ? #ffffff : #ffffffb0;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // Pontinho: de onde vem o som agora
                    if i == root.aba_tocando : Rectangle {
                        x: parent.width - 20px;
                        y: (parent.height - self.height) / 2;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.cor;
                    }
                    chip_toque := TouchArea {
                        clicked => {
                            root.aba_selecionada(i);
                            root.rolar_para(0px);
                        }
                    }
                }
            }
        }

        // Busca (Esc ou Enter devolvem o foco aos atalhos)
        Rectangle {
            x: 20px;
            y: 44px;
            width: root.width - 40px - 48px;
            height: 40px;
            border-radius: 20px;
            background: #ffffff14;
            border-width: 1px;
            border-color: entrada.has-focus ? root.cor.with-alpha(0.8) : #ffffff1a;
            animate border-color { duration: 140ms; }

            Image {
                source: @image-url("icons/busca.svg");
                width: 16px;
                height: 16px;
                x: 14px;
                y: (parent.height - self.height) / 2;
                colorize: #ffffff90;
            }
            Text {
                x: 40px;
                height: parent.height;
                text: (root.texto_busca == "" && entrada.preedit-text == "") ? I18n.search_placeholder : "";
                color: #ffffff60;
                font-size: 14px;
                vertical-alignment: center;
            }
            FocusScope {
                x: 40px;
                width: parent.width - 52px;
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.devolver_foco();
                        return accept;
                    }
                    return reject;
                }

                entrada := TextInput {
                    height: parent.height;
                    color: #ffffff;
                    font-size: 14px;
                    vertical-alignment: center;
                    selection-background-color: root.cor.with-alpha(0.4);
                    text <=> root.texto_busca;
                    edited => {
                        root.busca_mudou(self.text);
                        root.rolar_para(0px);
                    }
                    accepted => { root.devolver_foco(); }
                }
            }
        }

        // Ordenar
        botao_ordem := Rectangle {
            x: root.width - 20px - 40px;
            y: 44px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: ordem_toque.has-hover ? #ffffff26 : #ffffff14;
            border-width: 1px;
            border-color: root.ordem_atual != 0 || root.midia_atual != 0 ? root.cor.with-alpha(0.8) : #ffffff1a;
            animate background { duration: 120ms; }

            Image {
                source: @image-url("icons/ordenar.svg");
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.ordem_atual != 0 || root.midia_atual != 0 ? root.cor : #ffffffcc;
            }
            ordem_toque := TouchArea {
                clicked => { menu_ordem.show(); }
            }
        }
        menu_ordem := PopupWindow {
            x: root.width - 20px - 220px;
            y: 88px;
            width: 220px;

            Rectangle {
                background: #101722f5;
                border-radius: 12px;
                border-width: 1px;
                border-color: #ffffff1f;

                VerticalLayout {
                    padding: 6px;

                    for nome[i] in root.opcoes_ordem: Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: opcao_toque.has-hover ? #ffffff14 : transparent;

                        opcao_toque := TouchArea {
                            clicked => {
                                root.ordem_escolhida(i);
                                root.devolver_foco();
                            }
                        }
                        Text {
                            x: 12px;
                            height: parent.height;
                            text: nome;
                            color: i == root.ordem_atual ? root.cor : #ffffffd0;
                            font-weight: i == root.ordem_atual ? 700 : 400;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    if root.aba_tem_video : Rectangle {
                        height: 9px;

                        Rectangle {
                            y: 4px;
                            height: 1px;
                            background: #ffffff1a;
                        }
                    }
                    if root.aba_tem_video : Text {
                        height: 24px;
                        x: 12px;
                        text: I18n.media_label;
                        color: #ffffff80;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    for nome[i] in root.aba_tem_video ? root.opcoes_midia : []: Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: midia_toque.has-hover ? #ffffff14 : transparent;

                        midia_toque := TouchArea {
                            clicked => {
                                root.midia_escolhida(i);
                                root.devolver_foco();
                            }
                        }
                        Text {
                            x: 12px;
                            height: parent.height;
                            text: nome;
                            color: i == root.midia_atual ? root.cor : #ffffffd0;
                            font-weight: i == root.midia_atual ? 700 : 400;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        lista := Flickable {
            visible: root.guia == 0;
            x: 12px;
            y: 96px;
            width: root.width - 24px;
            height: parent.height - self.y - 12px;
            content-height: root.total * root.passo;

            changed content-y => { root.informar(); }
            changed height => { root.informar(); }

            for l[i] in root.linhas: Linha {
                x: 0px;
                y: (root.primeira + i) * root.passo;
                width: lista.width;
                dados: l;
                selecionada: root.primeira + i == root.selecionado;
                cor: root.cor;
                barras: root.barras;
                clicado => {
                    root.linha_clicada(root.primeira + i);
                    root.devolver_foco();
                }
                estrela => { root.favorita_alternada(root.primeira + i); }
            }
        }

        // Grade de álbuns
        grade := Flickable {
            visible: root.guia == 2;
            x: 20px;
            y: 96px;
            width: root.width - 40px;
            height: parent.height - self.y - 12px;
            content-height: ceil(root.albuns.length / root.colunas) * (root.altura_cartao + root.vao);

            changed content-y => { root.informar_grade(); }
            changed height => { root.informar_grade(); }

            for a[i] in root.albuns: Rectangle {
                x: mod(i, root.colunas) * (root.largura_cartao + root.vao);
                y: floor(i / root.colunas) * (root.altura_cartao + root.vao);
                width: root.largura_cartao;
                height: root.altura_cartao;
                border-radius: 8px;
                background: cartao_toque.has-hover ? #ffffff14 : transparent;
                animate background { duration: 120ms; }

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.width;
                    border-radius: 6px;
                    clip: true;
                    background: root.cor.with-alpha(0.25);

                    if a.tem_capa : Image {
                        width: parent.width;
                        height: parent.height;
                        source: a.capa;
                        image-fit: cover;
                    }
                    if !a.tem_capa : Image {
                        source: @image-url("icons/disco.svg");
                        width: parent.width * 0.3;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #ffffff70;
                    }
                }
                Text {
                    x: 2px;
                    y: parent.width + 6px;
                    width: parent.width - 4px;
                    text: a.nome;
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    x: 2px;
                    y: parent.width + 25px;
                    width: parent.width - 4px;
                    text: a.detalhe;
                    color: #ffffff8c;
                    font-size: 11px;
                    overflow: elide;
                }
                cartao_toque := TouchArea {
                    clicked => {
                        root.album_clicado(i);
                        root.devolver_foco();
                    }
                }
            }
        }

        if root.guia == 2 && root.albuns.length == 0 : Text {
            y: 120px;
            width: root.width;
            text: I18n.albums_empty;
            color: #ffffff80;
            font-size: 14px;
            horizontal-alignment: center;
        }

        if root.guia == 0 && root.total == 0 : Text {
            y: 120px;
            width: root.width;
            text: I18n.library_empty;
            color: #ffffff80;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    // -------------------------------------------------------------
    // A seguir
    // -------------------------------------------------------------
    Rectangle {
        y: 64px;
        height: root.height - self.y;
        visible: root.guia == 1;

        for l[i] in root.fila: Linha {
            x: 12px;
            y: i * root.passo;
            width: root.width - 24px;
            dados: l;
            cor: root.cor;
            com_estrela: false;
            clicado => {
                root.fila_clicada(i);
                root.devolver_foco();
            }
        }

        if root.fila.length == 0 : Text {
            y: 20px;
            width: root.width;
            text: I18n.up_next_empty;
            color: #ffffff80;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}
