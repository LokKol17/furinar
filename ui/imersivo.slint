// ---------------------------------------------------------------------
// Modo imersivo: tela cheia focada no visual
//
// Só existe enquanto o modo está ligado (`if` no MainWindow), então nada
// daqui pesa no modo normal. As imagens e a cor chegam prontas do Rust.
// ---------------------------------------------------------------------

import { Tema, BarraDeslizante } from "theme.slint";
import { I18n } from "i18n.slint";
import { PainelBiblioteca, LinhaPainel } from "painel.slint";

// Botão redondo e translúcido, para ficar sobre qualquer fundo
component BotaoImersivo inherits Rectangle {
    in property <image> icone;
    in property <string> dica: "";
    in property <bool> ativo: false;
    in property <bool> grande: false;
    in property <color> cor: Tema.oceano;
    callback clicado();

    width: grande ? 48px : 36px;
    height: self.width;
    border-radius: self.width / 2;
    background: grande ? #ffffff : (touch.has-hover ? #ffffff26 : transparent);
    accessible-role: button;
    accessible-label: root.dica;
    animate background { duration: 120ms; }

    Image {
        source: root.icone;
        width: grande ? 22px : 18px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        colorize: grande ? #0b1a2b : (root.ativo ? root.cor : #ffffffdd);
        animate colorize { duration: 200ms; }
    }

    touch := TouchArea {
        clicked => { root.clicado(); }
    }

    states [
        pressionado when touch.pressed : {
            opacity: 0.7;
        }
    ]
}

export component TelaImersiva inherits Rectangle {
    // Fundo: duas camadas para o crossfade. O Rust escreve na camada oculta e
    // inverte `mostra_a`; quadros de animação vão direto na camada visível.
    in property <image> fundo_a;
    in property <image> fundo_b;
    in property <bool> mostra_a: true;
    in property <bool> tem_fundo: false;
    in property <bool> fundo_pixelado: false;

    in property <image> capa;
    in property <bool> tem_capa: false;
    in property <string> titulo: "";
    in property <string> creditos: "";
    in property <string> tecnico: "";
    in property <color> cor: Tema.oceano;

    in property <[string]> letra: [];
    in property <int> letra_indice: -1;
    in property <[float]> barras: [];

    in property <bool> tocando: false;
    in property <bool> loop_ativo: false;
    in property <int> shuffle_modo: 0;
    in property <string> texto_tempo: "";
    in-out property <float> volume: 0;
    in-out property <float> progresso: 0;

    // Painel da biblioteca (gaveta à direita)
    in-out property <bool> painel_aberto: false;
    in property <[string]> abas;
    in property <int> aba_ativa;
    in property <int> aba_tocando: -1;
    in-out property <string> texto_busca;
    in property <int> painel_total;
    in property <int> painel_primeira;
    in property <[LinhaPainel]> painel_linhas;
    in property <[LinhaPainel]> fila;
    in property <int> selecionado: -1;
    in property <int> pedido_rolar;
    in property <int> pedido_busca;

    /// Só a letra sobre o fundo (tecla H)
    in-out property <bool> so_letra: false;
    in property <string> relogio: "";
    /// Indicador do temporizador de sono ("" = desligado)
    in property <string> sono: "";

    callback sair();
    callback anterior();
    callback play_pause();
    callback proxima();
    callback alternar_loop();
    callback alternar_shuffle();
    callback volume_mudou(float);
    callback progresso_mudou(float);
    callback letra_clicada(int);
    callback painel_alternado(bool);
    callback aba_selecionada(int);
    callback busca_mudou(string);
    callback painel_rolou(int, int);
    callback linha_clicada(int);
    callback fila_clicada(int);
    callback devolver_foco();
    callback alternar_sono();

    background: #05080d;

    /// Controles escondidos depois de alguns segundos sem mexer o mouse
    property <bool> ocioso: false;
    property <color> destaque: root.cor;
    animate destaque { duration: 700ms; easing: ease-in-out; }

    property <length> altura_linha: 46px;
    property <length> margem: 28px;
    property <length> lado_capa: min(190px, root.height * 0.2);
    // Rodapé, de baixo para cima: controles, progresso, visualizador, cartão
    property <length> y_progresso: root.height - 96px;
    property <length> altura_visualizador: 56px;
    property <length> y_visualizador: root.y_progresso - 10px - root.altura_visualizador;
    property <length> y_cartao: root.y_visualizador - 18px - root.lado_capa;
    // Largura que sobra à esquerda do painel; segue a gaveta enquanto ela anima
    property <length> largura_util: painel.x;
    /// Cartão, visualizador e controles somem no modo só letra
    property <float> opacidade_extras: root.so_letra ? 0 : 1;
    animate opacidade_extras { duration: 450ms; easing: ease-in-out; }

    changed painel_aberto => {
        root.acordar();
        root.painel_alternado(root.painel_aberto);
        if (root.painel_aberto) {
            painel.abrir();
        }
    }

    function acordar() {
        root.ocioso = false;
        auto_hide.restart();
    }

    // Sem imagem: gradiente tingido pela cor da capa. O renderer de software
    // pinta cada camada de tela cheia a cada quadro do fundo, então camada
    // escondida atrás de outra opaca fica invisível de verdade.
    Rectangle {
        visible: !root.tem_fundo;
        background: @linear-gradient(160deg, root.destaque.darker(0.75), #05080d 70%);
    }

    // Fundo (capa desfocada, imagem, GIF ou vídeo)
    Image {
        visible: root.tem_fundo && self.opacity > 0;
        width: 100%;
        height: 100%;
        source: root.fundo_a;
        image-fit: cover;
        image-rendering: root.fundo_pixelado ? ImageRendering.pixelated : ImageRendering.smooth;
        opacity: root.mostra_a ? 1 : 0;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
    Image {
        visible: root.tem_fundo && self.opacity > 0;
        width: 100%;
        height: 100%;
        source: root.fundo_b;
        image-fit: cover;
        image-rendering: root.fundo_pixelado ? ImageRendering.pixelated : ImageRendering.smooth;
        opacity: root.mostra_a ? 0 : 1;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }

    // Véu: escurece mais no rodapé, para o texto ler. Duas paradas só: com
    // uma parada no meio o renderer de software deixa uma linha na emenda.
    Rectangle {
        background: @linear-gradient(180deg, #00000059 0%, #000000d0 100%);
    }

    // Área inteira: mouse se mexendo acorda os controles. Fica embaixo dos
    // botões, que continuam recebendo o clique.
    area := TouchArea {
        mouse-cursor: root.ocioso ? MouseCursor.none : MouseCursor.default;
        changed mouse-x => { root.acordar(); }
        changed mouse-y => { root.acordar(); }
    }

    auto_hide := Timer {
        interval: 3s;
        running: !root.ocioso && !root.painel_aberto;
        triggered => { root.ocioso = true; }
    }

    // -------------------------------------------------------------
    // Letra (ou título, quando não há letra)
    // -------------------------------------------------------------
    letra_area := Rectangle {
        x: root.largura_util * 0.12;
        y: root.height * 0.06;
        width: root.largura_util * 0.76;
        height: (root.so_letra ? root.height * 0.94 : root.y_cartao - 24px) - self.y;
        animate height { duration: 450ms; easing: ease-in-out; }
        clip: true;

        // Desloca o bloco para a linha atual ficar no centro
        property <length> desloc: self.height / 2 - (max(0, root.letra_indice) + 0.5) * root.altura_linha;
        animate desloc { duration: 450ms; easing: ease-out; }

        for linha[i] in root.letra: Rectangle {
            x: 0px;
            y: letra_area.desloc + i * root.altura_linha;
            width: letra_area.width;
            height: root.altura_linha;

            property <int> distancia: abs(i - root.letra_indice);

            Text {
                width: parent.width;
                height: parent.height;
                text: linha;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                color: i == root.letra_indice ? #ffffff : #ffffff.with-alpha(max(0.18, 0.75 - parent.distancia * 0.14));
                font-size: i == root.letra_indice ? 32px : 20px;
                font-weight: i == root.letra_indice ? 800 : 500;
                animate font-size, color { duration: 300ms; easing: ease-out; }
            }

            TouchArea {
                mouse-cursor: root.ocioso ? MouseCursor.none : MouseCursor.pointer;
                clicked => { root.letra_clicada(i); }
            }
        }

        // Sem letra: o título ocupa o centro
        if root.letra.length == 0 : VerticalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: root.titulo;
                color: #ffffff;
                font-size: 40px;
                font-weight: 800;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: root.creditos;
                color: #ffffffb0;
                font-size: 18px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // -------------------------------------------------------------
    // Cartão da capa + informações
    // -------------------------------------------------------------
    cartao := Rectangle {
        visible: root.opacidade_extras > 0;
        opacity: root.opacidade_extras;
        x: root.margem;
        y: root.y_cartao;
        width: root.lado_capa;
        height: root.lado_capa;
        border-radius: 6px;
        background: #ffffff;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        drop-shadow-offset-y: 6px;

        Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            border-radius: 3px;
            clip: true;
            background: @linear-gradient(135deg, root.destaque, root.destaque.darker(0.6));

            if root.tem_capa : Image {
                width: parent.width;
                height: parent.height;
                source: root.capa;
                image-fit: cover;
            }
            if !root.tem_capa : Image {
                source: @image-url("icons/letra.svg");
                width: parent.width * 0.35;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffffcc;
            }
        }
    }

    VerticalLayout {
        visible: root.opacidade_extras > 0;
        opacity: root.opacidade_extras;
        x: cartao.x + cartao.width + 24px;
        y: cartao.y;
        width: root.largura_util - self.x - root.margem;
        height: cartao.height;
        alignment: end;
        spacing: 4px;

        Text {
            text: root.titulo;
            color: #ffffff;
            font-size: 28px;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            visible: root.creditos != "";
            text: root.creditos;
            color: #ffffffd0;
            font-size: 15px;
            overflow: elide;
        }
        Text {
            visible: root.tecnico != "";
            text: root.tecnico;
            color: #ffffff90;
            font-size: 13px;
            overflow: elide;
        }
    }

    // -------------------------------------------------------------
    // Visualizador
    // -------------------------------------------------------------
    visualizador := Rectangle {
        x: root.margem;
        width: root.largura_util - 2 * root.margem;
        height: root.altura_visualizador;
        y: root.y_visualizador;
        visible: root.barras.length > 0 && root.opacidade_extras > 0;
        opacity: root.opacidade_extras;

        property <length> passo: self.width / max(1, root.barras.length);

        for b[i] in root.barras: Rectangle {
            x: i * visualizador.passo + 1px;
            width: visualizador.passo - 2px;
            height: max(2px, b * visualizador.height);
            y: visualizador.height - self.height;
            border-radius: 2px;
            background: root.destaque.with-alpha(0.55);
        }
    }

    // -------------------------------------------------------------
    // Controles (somem quando ocioso)
    // -------------------------------------------------------------
    // Relógio e sono: sempre à vista (fora do modo só letra), discretos
    VerticalLayout {
        visible: root.opacidade_extras > 0;
        opacity: root.opacidade_extras;
        x: root.largura_util - self.width - root.margem;
        y: 22px;
        width: 160px;
        height: self.preferred-height;
        spacing: 2px;

        Text {
            text: root.relogio;
            color: #ffffffb0;
            font-size: 22px;
            font-weight: 600;
            horizontal-alignment: right;
        }
        if root.sono != "" : HorizontalLayout {
            alignment: end;
            spacing: 6px;

            Image {
                source: @image-url("icons/lua.svg");
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
                colorize: root.destaque;
            }
            Text {
                text: root.sono;
                color: root.destaque;
                font-size: 13px;
                font-weight: 600;
            }
        }
    }

    controles := Rectangle {
        visible: root.opacidade_extras > 0;
        opacity: root.ocioso ? 0 : root.opacidade_extras;
        animate opacity { duration: 450ms; easing: ease-in-out; }

        BotaoImersivo {
            x: 18px;
            y: 18px;
            icone: @image-url("icons/voltar.svg");
            dica: I18n.tip_exit_immersive;
            clicado => { root.sair(); }
        }

        HorizontalLayout {
            x: root.margem;
            y: root.y_progresso;
            width: root.largura_util - 2 * root.margem;
            height: 26px;
            spacing: 14px;

            Text {
                text: root.texto_tempo;
                color: #ffffffd0;
                font-size: 13px;
                vertical-alignment: center;
            }
            BarraDeslizante {
                horizontal-stretch: 1;
                valor <=> root.progresso;
                ao_vivo: false;
                cor: root.destaque;
                cor_trilha: #ffffff2e;
                mudou(v) => { root.progresso_mudou(v); }
            }
        }

        HorizontalLayout {
            x: root.margem - 6px;
            y: root.height - 64px;
            width: root.largura_util - 2 * root.margem + 12px;
            height: 52px;
            spacing: 8px;

            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/anterior.svg");
                dica: I18n.tip_previous;
                clicado => { root.anterior(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                grande: true;
                icone: root.tocando ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                clicado => { root.play_pause(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/proxima.svg");
                dica: I18n.tip_next;
                clicado => { root.proxima(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/shuffle.svg");
                ativo: root.shuffle_modo != 0;
                cor: root.destaque;
                clicado => { root.alternar_shuffle(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/loop.svg");
                ativo: root.loop_ativo;
                cor: root.destaque;
                clicado => { root.alternar_loop(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/biblioteca.svg");
                dica: I18n.tip_library;
                ativo: root.painel_aberto;
                cor: root.destaque;
                clicado => { root.painel_aberto = !root.painel_aberto; }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/letra.svg");
                dica: I18n.tip_lyrics_only;
                clicado => { root.so_letra = true; }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/lua.svg");
                dica: I18n.tip_sleep;
                ativo: root.sono != "";
                cor: root.destaque;
                clicado => { root.alternar_sono(); }
            }
            Image {
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/volume.svg");
                width: 18px;
                height: 18px;
                colorize: #ffffffdd;
            }
            BarraDeslizante {
                y: (parent.height - self.height) / 2;
                width: 120px;
                valor <=> root.volume;
                cor: root.destaque;
                cor_trilha: #ffffff2e;
                mudou(v) => { root.volume_mudou(v); }
            }

            Rectangle { horizontal-stretch: 1; }

            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/sair_tela_cheia.svg");
                dica: I18n.tip_exit_immersive;
                clicado => { root.sair(); }
            }
        }
    }

    // -------------------------------------------------------------
    // Painel da biblioteca: desliza da direita
    // -------------------------------------------------------------
    painel := PainelBiblioteca {
        width: min(500px, root.width * 0.4);
        height: root.height;
        x: root.painel_aberto ? root.width - self.width : root.width;
        animate x { duration: 280ms; easing: ease-out; }
        visible: self.x < root.width;

        abas: root.abas;
        aba_ativa: root.aba_ativa;
        aba_tocando: root.aba_tocando;
        texto_busca <=> root.texto_busca;
        total: root.painel_total;
        primeira: root.painel_primeira;
        linhas: root.painel_linhas;
        fila: root.fila;
        selecionado: root.selecionado;
        pedido_rolar: root.pedido_rolar;
        pedido_busca: root.pedido_busca;
        cor: root.destaque;
        barras: root.barras;

        aba_selecionada(i) => { root.aba_selecionada(i); }
        busca_mudou(t) => { root.busca_mudou(t); }
        rolou(a, b) => { root.painel_rolou(a, b); }
        linha_clicada(i) => { root.linha_clicada(i); }
        fila_clicada(i) => { root.fila_clicada(i); }
        devolver_foco => { root.devolver_foco(); }
        fechar => { root.painel_aberto = false; }
    }
}
