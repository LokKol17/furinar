// ---------------------------------------------------------------------
// Modo imersivo: tela cheia focada no visual
//
// Só existe enquanto o modo está ligado (`if` no MainWindow), então nada
// daqui pesa no modo normal. As imagens e a cor chegam prontas do Rust.
// ---------------------------------------------------------------------

import { Tema, BarraDeslizante, Dica } from "theme.slint";
import { I18n } from "i18n.slint";
import { PainelBiblioteca, LinhaPainel, CartaoAlbum } from "painel.slint";

// Botão redondo e translúcido, para ficar sobre qualquer fundo
component BotaoImersivo inherits Rectangle {
    in property <image> icone;
    in property <string> dica: "";
    in property <bool> ativo: false;
    /// Modo desligado: ícone apagado
    in property <bool> apagado: false;
    in property <bool> grande: false;
    in property <color> cor: Tema.oceano;
    in property <string> atalho: "";
    callback clicado();

    width: grande ? 48px : 36px;
    height: self.width;
    border-radius: self.width / 2;
    background: grande ? #ffffff : (touch.has-hover ? #ffffff26 : transparent);
    accessible-role: button;
    accessible-label: root.atalho != "" ? root.dica + " (" + root.atalho + ")" : root.dica;
    animate background { duration: 120ms; }
    animate transform-scale-x, transform-scale-y { duration: 140ms; easing: ease-out-back; }

    Image {
        source: root.icone;
        width: grande ? 22px : 18px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        colorize: grande ? #0b1a2b : (root.ativo ? root.cor : (root.apagado ? #ffffff59 : #ffffffdd));
        animate colorize { duration: 200ms; }
        transform-scale-x: root.trocando ? 55% : 100%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x, transform-scale-y { duration: root.trocando ? 70ms : 220ms; easing: root.trocando ? ease-in : ease-out-back; }
    }

    // Troca de ícone (play/pause, estrela, modos): some rápido e volta com mola
    private property <bool> trocando: false;
    changed icone => {
        root.trocando = true;
        volta.running = true;
    }
    volta := Timer {
        interval: 80ms;
        running: false;
        triggered => {
            root.trocando = false;
            self.running = false;
        }
    }

    touch := TouchArea {
        clicked => { root.clicado(); }
    }

    if root.dica != "" : Tooltip {
        Dica {
            texto: root.dica;
            atalho: root.atalho;
            escura: true;
        }
    }

    states [
        pressionado when touch.pressed : {
            opacity: 0.7;
            transform-scale-x: 90%;
            transform-scale-y: 90%;
        }
    ]
}

// Interruptor no estilo da tela cheia
component OpcaoImersiva inherits Rectangle {
    in property <string> rotulo;
    in property <string> descricao: "";
    in-out property <bool> ligado;
    in property <color> cor;
    callback alternado(bool);

    height: textos.preferred-height + 16px;
    border-radius: 10px;
    background: toque.has-hover ? #ffffff0f : transparent;
    animate background { duration: 120ms; }

    textos := VerticalLayout {
        x: 12px;
        width: parent.width - 80px;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.rotulo;
            color: #ffffff;
            font-size: 14px;
            wrap: word-wrap;
        }
        if root.descricao != "" : Text {
            text: root.descricao;
            color: #ffffff80;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    // Trilho + bolinha
    Rectangle {
        x: parent.width - 56px;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 22px;
        border-radius: 11px;
        background: root.ligado ? root.cor : #ffffff2e;
        animate background { duration: 160ms; }

        Rectangle {
            x: root.ligado ? parent.width - self.width - 3px : 3px;
            y: 3px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: #ffffff;
            animate x { duration: 160ms; easing: ease-out; }
        }
    }

    toque := TouchArea {
        clicked => {
            root.ligado = !root.ligado;
            root.alternado(root.ligado);
        }
    }
}

// Campo de texto de uma linha no estilo da tela cheia
// Seletor de opções no estilo da tela cheia (o Segmentado do tema segue o
// tema claro/escuro; aqui é sempre escuro, com a cor da capa)
component SegmentadoImersivo inherits Rectangle {
    in property <[string]> opcoes;
    in property <int> atual;
    in property <color> cor;
    callback escolhido(int);

    height: 34px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #ffffff1f;
    background: #ffffff12;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;

        for opcao[i] in root.opcoes : Rectangle {
            border-radius: 8px;
            background: i == root.atual ? root.cor : (toque.has-hover ? #ffffff14 : transparent);
            animate background { duration: 120ms; }

            Text {
                text: opcao;
                color: #ffffff;
                font-size: 13px;
                font-weight: i == root.atual ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            toque := TouchArea {
                clicked => {
                    if (i != root.atual) {
                        root.escolhido(i);
                    }
                }
            }
        }
    }
}

component CampoImersivo inherits Rectangle {
    in-out property <string> texto;
    in property <bool> senha: false;
    in property <string> placeholder: "";
    in property <color> cor;
    callback editado(string);

    height: 34px;
    border-radius: 10px;
    background: #ffffff12;
    border-width: 1px;
    border-color: entrada.has-focus ? root.cor : #ffffff1f;

    Text {
        x: 12px;
        height: parent.height;
        text: root.texto == "" ? root.placeholder : "";
        color: #ffffff59;
        font-size: 13px;
        vertical-alignment: center;
    }
    entrada := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        color: #ffffff;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.senha ? InputType.password : InputType.text;
        text <=> root.texto;
        edited => { root.editado(self.text); }
    }
}

// Botão de texto translúcido (opções da tela cheia)
component BotaoTexto inherits Rectangle {
    in property <string> texto;
    callback clicado();

    height: 34px;
    min-width: rotulo.preferred-width + 28px;
    border-radius: 17px;
    background: toque.has-hover ? #ffffff2e : #ffffff17;
    border-width: 1px;
    border-color: #ffffff1f;
    animate background { duration: 120ms; }

    rotulo := Text {
        text: root.texto;
        color: #ffffff;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    toque := TouchArea {
        clicked => { root.clicado(); }
    }
}

export component TelaImersiva inherits Rectangle {
    // Fundo: duas camadas para o crossfade. O Rust escreve na camada oculta e
    // inverte `mostra_a`; quadros de animação vão direto na camada visível.
    in property <image> fundo_a;
    in property <image> fundo_b;
    in property <bool> mostra_a: true;
    in property <bool> tem_fundo: false;
    in property <bool> fundo_pixelado: false;

    in property <image> capa;
    in property <bool> tem_capa: false;
    in property <string> titulo: "";
    in property <string> creditos: "";
    in property <string> tecnico: "";
    in property <color> cor: Tema.oceano;

    // Troca de faixa: título e capa somem rápido e voltam suaves
    private property <bool> trocando_faixa: false;
    changed titulo => {
        root.trocando_faixa = true;
        fim_troca.running = true;
    }
    fim_troca := Timer {
        interval: 90ms;
        running: false;
        triggered => {
            root.trocando_faixa = false;
            self.running = false;
        }
    }
    private property <float> entrada: root.trocando_faixa ? 0 : 1;
    animate entrada { duration: root.trocando_faixa ? 80ms : 320ms; easing: ease-out; }

    in property <[string]> letra: [];
    in property <int> letra_indice: -1;
    in property <[float]> barras: [];

    in property <bool> tocando: false;
    /// 0 = desligado, 1 = faixa, 2 = lista
    in property <int> loop_modo: 0;
    in property <int> shuffle_modo: 0;
    in property <string> texto_loop;
    in property <string> texto_shuffle;
    in property <string> texto_tempo: "";
    in-out property <float> volume: 0;
    in-out property <float> progresso: 0;

    // Painel da biblioteca (gaveta à direita)
    in-out property <bool> painel_aberto: false;
    in property <[string]> abas;
    in property <int> aba_ativa;
    in property <int> aba_tocando: -1;
    in-out property <string> texto_busca;
    in property <int> painel_total;
    in property <int> painel_primeira;
    in property <[LinhaPainel]> painel_linhas;
    in property <[LinhaPainel]> fila;
    in property <int> selecionado: -1;
    in property <int> pedido_rolar;
    in property <int> pedido_busca;

    /// Só a letra sobre o fundo (tecla H)
    in-out property <bool> so_letra: false;
    /// A faixa é um vídeo e ele está no fundo
    in property <bool> e_video: false;
    /// Só o vídeo (tecla V): sem texto, controles nem véu escurecendo
    in-out property <bool> so_video: false;
    in property <string> relogio: "";
    /// Indicador do temporizador de sono ("" = desligado)
    in property <string> sono: "";
    /// Letra sem tempos: rolável, sem destaque
    in property <bool> letra_livre: false;
    /// Quanto da linha atual já foi cantado (0 a 1), para o karaokê
    in property <float> letra_progresso: 0;
    in property <bool> favorita: false;
    /// "Título — Artista" da próxima nos últimos segundos ("" = escondida)
    in property <string> texto_proxima: "";
    /// Graves (0..1): o fundo cresce e clareia um pouco nas batidas
    in property <float> pulso: 0;
    in property <[CartaoAlbum]> albuns;
    in-out property <int> guia: 0;
    in property <int> ordem_atual;
    in property <[string]> opcoes_ordem;
    in property <int> especiais;

    // Configurações da tela cheia
    in-out property <bool> config_aberta: false;
    in property <string> crossfade_texto;
    in-out property <bool> replaygain;
    in-out property <bool> fundo_reativo;
    in property <string> fundo_global_nome;
    in-out property <bool> letras_web;
    in-out property <bool> discord;
    in-out property <string> listenbrainz_token;
    in-out property <string> lastfm_chave;
    in-out property <string> lastfm_segredo;
    in property <bool> lastfm_conectado;
    in property <bool> lastfm_aguardando;
    in property <string> lastfm_estado;
    in property <string> scrobble_estado;
    in-out property <string> chave_acoustid;
    in-out property <bool> escanear_subpastas;
    in property <bool> ffmpeg_ausente;

    callback sair();
    callback anterior();
    callback play_pause();
    callback proxima();
    callback alternar_loop();
    callback alternar_shuffle();
    callback volume_mudou(float);
    callback progresso_mudou(float);
    callback letra_clicada(int);
    callback painel_alternado(bool);
    callback aba_selecionada(int);
    callback busca_mudou(string);
    callback painel_rolou(int, int);
    callback linha_clicada(int);
    callback fila_clicada(int);
    callback devolver_foco();
    callback alternar_sono();
    callback alternar_favorita();
    callback favorita_alternada(int);
    callback guia_mudou(int);
    callback albuns_rolou(int, int);
    callback album_clicado(int);
    callback ordem_escolhida(int);
    callback alternar_crossfade();
    callback alternar_replaygain(bool);
    callback alternar_fundo_reativo(bool);
    callback escolher_fundo();
    callback limpar_fundo();
    callback abrir_info();
    callback alternar_letras_web(bool);
    callback trocar_idioma(string);
    callback alternar_escanear_subpastas(bool);
    callback abrir_pagina_ffmpeg();
    callback alternar_discord(bool);
    callback listenbrainz_mudou(string);
    callback lastfm_credenciais_mudou(string, string);
    callback lastfm_conectar();
    callback lastfm_concluir();
    callback lastfm_desconectar();
    callback chave_acoustid_mudou(string);

    background: #05080d;

    /// Controles escondidos depois de alguns segundos sem mexer o mouse
    in-out property <bool> ocioso: false;
    property <color> destaque: root.cor;
    animate destaque { duration: 700ms; easing: ease-in-out; }

    property <length> altura_linha: 46px;
    property <length> margem: 28px;
    property <length> lado_capa: min(190px, root.height * 0.2);
    // Rodapé, de baixo para cima: controles, progresso, visualizador, cartão
    property <length> y_progresso: root.height - 96px;
    property <length> altura_visualizador: 56px;
    // Base do visualizador: logo acima da barra de progresso; com os
    // controles escondidos, desce até o pé da tela (e o cartão vem junto),
    // em vez de ficar boiando sobre o espaço vazio
    property <length> base_rodape: root.ocioso ? root.height - 20px : root.y_progresso - 10px;
    animate base_rodape { duration: 450ms; easing: ease-in-out; }
    property <length> y_visualizador: root.base_rodape - root.altura_visualizador;
    property <length> y_cartao: root.y_visualizador - 18px - root.lado_capa;
    // Largura que sobra à esquerda do painel; segue a gaveta enquanto ela anima
    property <length> largura_util: painel.x;
    /// Modo só vídeo valendo (a faixa pode ter deixado de ser vídeo)
    property <bool> limpo: root.so_video && root.e_video;
    /// Cartão, visualizador e controles somem no modo só letra e no só vídeo
    property <float> opacidade_extras: root.so_letra || root.limpo ? 0 : 1;
    animate opacidade_extras { duration: 450ms; easing: ease-in-out; }
    /// Letra e véu: somem só no modo só vídeo
    property <float> opacidade_texto: root.limpo ? 0 : 1;
    animate opacidade_texto { duration: 450ms; easing: ease-in-out; }

    changed painel_aberto => {
        root.acordar();
        root.painel_alternado(root.painel_aberto);
        if (root.painel_aberto) {
            painel.abrir();
        }
    }

    function acordar() {
        root.ocioso = false;
        auto_hide.restart();
    }

    // Sem imagem: gradiente tingido pela cor da capa. O renderer de software
    // pinta cada camada de tela cheia a cada quadro do fundo, então camada
    // escondida atrás de outra opaca fica invisível de verdade.
    Rectangle {
        visible: !root.tem_fundo;
        background: @linear-gradient(160deg, root.destaque.darker(0.75), #05080d 70%);
    }

    // Fundo (capa desfocada, imagem, GIF ou vídeo). Cresce um pouco com o
    // pulso, a partir do centro.
    property <float> zoom: root.limpo ? 1 : 1 + root.pulso * 0.035;
    Image {
        visible: root.tem_fundo && self.opacity > 0;
        width: root.width * root.zoom;
        height: root.height * root.zoom;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        source: root.fundo_a;
        image-fit: cover;
        image-rendering: root.fundo_pixelado ? ImageRendering.pixelated : ImageRendering.smooth;
        opacity: root.mostra_a ? 1 : 0;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
    Image {
        visible: root.tem_fundo && self.opacity > 0;
        width: root.width * root.zoom;
        height: root.height * root.zoom;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        source: root.fundo_b;
        image-fit: cover;
        image-rendering: root.fundo_pixelado ? ImageRendering.pixelated : ImageRendering.smooth;
        opacity: root.mostra_a ? 0 : 1;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }

    // Véu: escurece mais no rodapé, para o texto ler. Duas paradas só: com
    // uma parada no meio o renderer de software deixa uma linha na emenda.
    Rectangle {
        background: @linear-gradient(180deg, #00000059 0%, #000000d0 100%);
        visible: root.opacidade_texto > 0;
        opacity: (1 - root.pulso * 0.3) * root.opacidade_texto;
    }

    // Área inteira: mouse se mexendo acorda os controles. Fica embaixo dos
    // botões, que continuam recebendo o clique.
    area := TouchArea {
        mouse-cursor: root.ocioso ? MouseCursor.none : MouseCursor.default;
        changed mouse-x => { root.acordar(); }
        changed mouse-y => { root.acordar(); }
    }

    auto_hide := Timer {
        interval: 3s;
        running: !root.ocioso && !root.painel_aberto && !root.config_aberta;
        triggered => { root.ocioso = true; }
    }

    // -------------------------------------------------------------
    // Letra (ou título, quando não há letra)
    // -------------------------------------------------------------
    letra_area := Rectangle {
        x: root.largura_util * 0.12;
        y: root.height * 0.06;
        width: root.largura_util * 0.76;
        height: (root.so_letra ? root.height * 0.94 : root.y_cartao - 24px) - self.y;
        animate height { duration: 450ms; easing: ease-in-out; }
        clip: true;
        visible: root.opacidade_texto > 0;
        opacity: root.opacidade_texto;

        // Desloca o bloco para a linha atual ficar no centro
        property <length> desloc: self.height / 2 - (max(0, root.letra_indice) + 0.5) * root.altura_linha;
        animate desloc { duration: 450ms; easing: ease-out; }

        for linha[i] in root.letra_livre ? [] : root.letra: Rectangle {
            x: 0px;
            y: letra_area.desloc + i * root.altura_linha;
            width: letra_area.width;
            height: root.altura_linha;

            property <int> distancia: abs(i - root.letra_indice);

            // Linha atual em karaokê: o texto apagado embaixo e o aceso por
            // cima, recortado até onde já foi cantado
            base_linha := Text {
                width: parent.width;
                height: parent.height;
                text: linha;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                color: i == root.letra_indice ? #ffffff.with-alpha(0.42) : #ffffff.with-alpha(max(0.18, 0.75 - parent.distancia * 0.14));
                font-size: i == root.letra_indice ? 32px : 20px;
                font-weight: i == root.letra_indice ? 800 : 500;
                animate font-size, color { duration: 300ms; easing: ease-out; }
            }
            if i == root.letra_indice : Rectangle {
                property <length> largura_texto: min(base_linha.preferred-width, parent.width);
                x: (parent.width - self.largura_texto) / 2;
                width: self.largura_texto * root.letra_progresso;
                height: parent.height;
                clip: true;

                Text {
                    x: -parent.x;
                    width: base_linha.width;
                    height: parent.height;
                    text: linha;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                    color: #ffffff;
                    font-size: base_linha.font-size;
                    font-weight: 800;
                }
            }

            TouchArea {
                mouse-cursor: root.ocioso ? MouseCursor.none : MouseCursor.pointer;
                clicked => { root.letra_clicada(i); }
            }
        }

        // Sem tempos: o texto inteiro, rolável, todo no mesmo tom
        if root.letra_livre : Flickable {
            width: parent.width;
            height: parent.height;
            content-height: texto_livre.preferred-height;

            texto_livre := VerticalLayout {
                padding-top: letra_area.height * 0.2;
                padding-bottom: letra_area.height * 0.2;
                spacing: 6px;

                for linha in root.letra: Text {
                    text: linha;
                    color: #ffffffd0;
                    font-size: 22px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Sem letra: o título ocupa o centro
        if root.letra.length == 0 : VerticalLayout {
            alignment: center;
            spacing: 10px;
            opacity: root.entrada;

            Text {
                text: root.titulo;
                color: #ffffff;
                font-size: 40px;
                font-weight: 800;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: root.creditos;
                color: #ffffffb0;
                font-size: 18px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // -------------------------------------------------------------
    // Cartão da capa + informações
    // -------------------------------------------------------------
    cartao := Rectangle {
        visible: root.opacidade_extras > 0;
        opacity: root.opacidade_extras;
        x: root.margem;
        y: root.y_cartao;
        width: root.lado_capa;
        height: root.lado_capa;
        border-radius: 6px;
        background: #ffffff;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        drop-shadow-offset-y: 6px;

        Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            border-radius: 3px;
            clip: true;
            background: @linear-gradient(135deg, root.destaque, root.destaque.darker(0.6));

            if root.tem_capa : Image {
                width: parent.width;
                height: parent.height;
                source: root.capa;
                image-fit: cover;
                opacity: root.entrada;
            }
            if !root.tem_capa : Image {
                source: @image-url("icons/letra.svg");
                width: parent.width * 0.35;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffffcc;
            }
        }
    }

    VerticalLayout {
        visible: root.opacidade_extras > 0;
        opacity: root.opacidade_extras * root.entrada;
        x: cartao.x + cartao.width + 24px;
        y: cartao.y;
        width: root.largura_util - self.x - root.margem;
        height: cartao.height;
        alignment: end;
        spacing: 4px;

        Text {
            text: root.titulo;
            color: #ffffff;
            font-size: 28px;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            visible: root.creditos != "";
            text: root.creditos;
            color: #ffffffd0;
            font-size: 15px;
            overflow: elide;
        }
        Text {
            visible: root.tecnico != "";
            text: root.tecnico;
            color: #ffffff90;
            font-size: 13px;
            overflow: elide;
        }
    }

    // -------------------------------------------------------------
    // Visualizador
    // -------------------------------------------------------------
    visualizador := Rectangle {
        x: root.margem;
        width: root.largura_util - 2 * root.margem;
        height: root.altura_visualizador;
        y: root.y_visualizador;
        visible: root.barras.length > 0 && root.opacidade_extras > 0;
        opacity: root.opacidade_extras;

        property <length> passo: self.width / max(1, root.barras.length);

        for b[i] in root.barras: Rectangle {
            x: i * visualizador.passo + 1px;
            width: visualizador.passo - 2px;
            height: max(2px, b * visualizador.height);
            y: visualizador.height - self.height;
            border-radius: 2px;
            background: root.destaque.with-alpha(0.55);
        }
    }

    // -------------------------------------------------------------
    // Controles (somem quando ocioso)
    // -------------------------------------------------------------
    // Relógio e sono: sempre à vista (fora do modo só letra), discretos
    VerticalLayout {
        visible: root.opacidade_extras > 0;
        opacity: root.opacidade_extras;
        // Ao lado do botão da biblioteca
        x: root.largura_util - self.width - root.margem - 48px;
        y: 22px;
        width: 160px;
        height: self.preferred-height;
        spacing: 2px;

        Text {
            text: root.relogio;
            color: #ffffffb0;
            font-size: 22px;
            font-weight: 600;
            horizontal-alignment: right;
        }
        if root.sono != "" : HorizontalLayout {
            alignment: end;
            spacing: 6px;

            Image {
                source: @image-url("icons/lua.svg");
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
                colorize: root.destaque;
            }
            Text {
                text: root.sono;
                color: root.destaque;
                font-size: 13px;
                font-weight: 600;
            }
        }
    }

    // Prévia da próxima: aparece por cima do cartão nos últimos segundos
    previa := Rectangle {
        property <bool> ativa: root.texto_proxima != "" && !root.so_letra && !root.limpo;
        x: root.margem;
        y: root.y_cartao - 46px + (self.ativa ? 0px : 12px);
        width: min(root.largura_util - 2 * root.margem, previa_texto.preferred-width + 34px);
        height: 34px;
        border-radius: 17px;
        background: #00000080;
        border-width: 1px;
        border-color: root.destaque.with-alpha(0.6);
        opacity: self.ativa ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity, y { duration: 400ms; easing: ease-out; }

        // Guarda o último texto para ele não sumir antes do fade
        property <string> texto;
        changed ativa => {
            if (self.ativa) {
                self.texto = root.texto_proxima;
            }
        }
        previa_texto := Text {
            x: 17px;
            width: parent.width - 34px;
            height: parent.height;
            text: I18n.up_next_preview + " · " + (root.texto_proxima != "" ? root.texto_proxima : previa.texto);
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Só vídeo: um botão só para voltar, que aparece ao mexer o mouse
    // (com fundo próprio: sem o véu, o vídeo pode ser claro atrás dele)
    if root.limpo : Rectangle {
        x: 18px;
        y: 18px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: #00000080;
        opacity: root.ocioso ? 0 : 1;
        animate opacity { duration: 450ms; easing: ease-in-out; }

        BotaoImersivo {
            icone: @image-url("icons/video.svg");
            dica: I18n.tip_video_only;
            atalho: "V";
            ativo: true;
            cor: root.destaque;
            clicado => { root.so_video = false; }
        }
    }

    controles := Rectangle {
        visible: root.opacidade_extras > 0;
        opacity: root.ocioso ? 0 : root.opacidade_extras;
        animate opacity { duration: 450ms; easing: ease-in-out; }

        // Biblioteca no alto à direita, do lado de onde a gaveta abre
        BotaoImersivo {
            x: root.largura_util - root.margem - self.width;
            y: 18px;
            icone: @image-url("icons/biblioteca.svg");
            dica: I18n.tip_library;
            atalho: "L";
            ativo: root.painel_aberto;
            cor: root.destaque;
            clicado => { root.painel_aberto = !root.painel_aberto; }
        }

        // Navegação no alto; embaixo fica só o que mexe na música
        HorizontalLayout {
            x: 18px;
            y: 18px;
            width: self.preferred-width;
            height: 36px;
            spacing: 6px;

            BotaoImersivo {
                icone: @image-url("icons/voltar.svg");
                dica: I18n.tip_exit_immersive;
                atalho: "Esc";
                clicado => { root.sair(); }
            }
            BotaoImersivo {
                icone: @image-url("icons/info.svg");
                dica: I18n.tip_info;
                atalho: "I";
                clicado => { root.abrir_info(); }
            }
            BotaoImersivo {
                icone: @image-url("icons/config.svg");
                dica: I18n.tip_settings;
                ativo: root.config_aberta;
                cor: root.destaque;
                clicado => {
                    root.config_aberta = !root.config_aberta;
                    root.acordar();
                }
            }
        }

        HorizontalLayout {
            x: root.margem;
            y: root.y_progresso;
            width: root.largura_util - 2 * root.margem;
            height: 26px;
            spacing: 14px;

            Text {
                text: root.texto_tempo;
                color: #ffffffd0;
                font-size: 13px;
                vertical-alignment: center;
            }
            BarraDeslizante {
                horizontal-stretch: 1;
                valor <=> root.progresso;
                ao_vivo: false;
                cor: root.destaque;
                cor_trilha: #ffffff2e;
                mudou(v) => { root.progresso_mudou(v); }
            }
        }

        HorizontalLayout {
            x: root.margem - 6px;
            y: root.height - 64px;
            width: root.largura_util - 2 * root.margem + 12px;
            height: 52px;
            spacing: 8px;

            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/anterior.svg");
                dica: I18n.tip_previous;
                clicado => { root.anterior(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                grande: true;
                icone: root.tocando ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                dica: root.tocando ? I18n.pause_label : I18n.play_label;
                atalho: I18n.key_space;
                clicado => { root.play_pause(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/proxima.svg");
                dica: I18n.tip_next;
                clicado => { root.proxima(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                // Inteligente = baralho embaralhado (cada uma uma vez);
                // aleatório = dado (pode repetir)
                icone: root.shuffle_modo == 1 ? @image-url("icons/dado.svg") : @image-url("icons/shuffle.svg");
                dica: root.texto_shuffle;
                ativo: root.shuffle_modo != 0;
                apagado: root.shuffle_modo == 0;
                cor: root.destaque;
                clicado => { root.alternar_shuffle(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: root.loop_modo == 1 ? @image-url("icons/loop_faixa.svg") : @image-url("icons/loop.svg");
                dica: root.texto_loop;
                ativo: root.loop_modo != 0;
                apagado: root.loop_modo == 0;
                cor: root.destaque;
                clicado => { root.alternar_loop(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/letra.svg");
                dica: I18n.tip_lyrics_only;
                atalho: "H";
                clicado => { root.so_letra = true; }
            }
            if root.e_video : BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/video.svg");
                dica: I18n.tip_video_only;
                atalho: "V";
                clicado => { root.so_video = true; }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: root.favorita ? @image-url("icons/estrela_cheia.svg") : @image-url("icons/estrela.svg");
                dica: I18n.tip_favorite;
                atalho: "F";
                ativo: root.favorita;
                cor: root.destaque;
                clicado => { root.alternar_favorita(); }
            }
            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/lua.svg");
                dica: I18n.tip_sleep;
                ativo: root.sono != "";
                cor: root.destaque;
                clicado => { root.alternar_sono(); }
            }
            Image {
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/volume.svg");
                width: 18px;
                height: 18px;
                colorize: #ffffffdd;
            }
            BarraDeslizante {
                y: (parent.height - self.height) / 2;
                width: 120px;
                valor <=> root.volume;
                cor: root.destaque;
                cor_trilha: #ffffff2e;
                mudou(v) => { root.volume_mudou(v); }
            }

            Rectangle { horizontal-stretch: 1; }

            BotaoImersivo {
                y: (parent.height - self.height) / 2;
                icone: @image-url("icons/sair_tela_cheia.svg");
                dica: I18n.tip_exit_immersive;
                atalho: "Esc";
                clicado => { root.sair(); }
            }
        }
    }

    // -------------------------------------------------------------
    // Configurações: cartão de vidro escuro sobre a tela
    // -------------------------------------------------------------
    if root.config_aberta : Rectangle {
        background: #00000070;

        // Clique fora fecha
        TouchArea {
            clicked => { root.config_aberta = false; }
        }

        cartao_config := Rectangle {
            width: min(440px, root.largura_util - 2 * root.margem);
            height: min(root.height - 80px, conteudo_config.preferred-height);
            x: (root.largura_util - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 18px;
            background: #0b1019;
            border-width: 1px;
            border-color: root.destaque.with-alpha(0.35);
            drop-shadow-blur: 40px;
            drop-shadow-color: #000000a0;

            // Engole o clique para não fechar
            TouchArea { }

            clip: true;

            Flickable {
                content-height: conteudo_config.preferred-height;

                conteudo_config := VerticalLayout {
                    padding: 20px;
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: I18n.config_title;
                            color: #ffffff;
                            font-size: 20px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        BotaoImersivo {
                            icone: @image-url("icons/x.svg");
                            dica: I18n.tip_close;
                            clicado => { root.config_aberta = false; }
                        }
                    }

                    // Idioma (o tema não entra: a tela cheia é sempre escura)
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;

                        Text {
                            text: I18n.language;
                            color: #ffffff;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        // Cada idioma escrito nele mesmo, como no modo normal
                        SegmentadoImersivo {
                            horizontal-stretch: 1;
                            opcoes: ["English", "Português"];
                            atual: I18n.idioma == "en" ? 0 : 1;
                            cor: root.destaque;
                            escolhido(i) => { root.trocar_idioma(i == 0 ? "en" : "pt-br"); }
                        }
                    }

                    OpcaoImersiva {
                        rotulo: I18n.scan_subfolders;
                        descricao: I18n.scan_subfolders_desc;
                        ligado <=> root.escanear_subpastas;
                        cor: root.destaque;
                        alternado(v) => { root.alternar_escanear_subpastas(v); }
                    }
                    OpcaoImersiva {
                        rotulo: I18n.replaygain;
                        descricao: I18n.replaygain_desc;
                        ligado <=> root.replaygain;
                        cor: root.destaque;
                        alternado(v) => { root.alternar_replaygain(v); }
                    }
                    OpcaoImersiva {
                        rotulo: I18n.reactive_bg;
                        ligado <=> root.fundo_reativo;
                        cor: root.destaque;
                        alternado(v) => { root.alternar_fundo_reativo(v); }
                    }

                    OpcaoImersiva {
                        rotulo: I18n.discord_status;
                        ligado <=> root.discord;
                        cor: root.destaque;
                        alternado(v) => { root.alternar_discord(v); }
                    }
                    OpcaoImersiva {
                        rotulo: I18n.lyrics_web;
                        descricao: I18n.lyrics_web_desc;
                        ligado <=> root.letras_web;
                        cor: root.destaque;
                        alternado(v) => { root.alternar_letras_web(v); }
                    }

                    // Crossfade: cada clique passa para a próxima duração
                    Rectangle {
                        height: 44px;
                        border-radius: 10px;
                        background: crossfade_toque.has-hover ? #ffffff0f : transparent;
                        animate background { duration: 120ms; }

                        Text {
                            x: 12px;
                            height: parent.height;
                            text: root.crossfade_texto;
                            color: #ffffff;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Image {
                            source: @image-url("icons/proxima.svg");
                            x: parent.width - 34px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            colorize: root.destaque;
                        }
                        crossfade_toque := TouchArea {
                            clicked => { root.alternar_crossfade(); }
                        }
                    }

                    // Chave do AcoustID
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;

                        Text {
                            text: I18n.acoustid_key;
                            color: #ffffff;
                            font-size: 14px;
                        }
                        Rectangle {
                            height: 34px;
                            border-radius: 10px;
                            background: #ffffff12;
                            border-width: 1px;
                            border-color: campo_chave.has-focus ? root.destaque : #ffffff1f;

                            campo_chave := TextInput {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                color: #ffffff;
                                font-size: 13px;
                                vertical-alignment: center;
                                single-line: true;
                                text <=> root.chave_acoustid;
                                edited => { root.chave_acoustid_mudou(self.text); }
                            }
                        }
                        Text {
                            text: I18n.acoustid_desc;
                            color: #ffffff80;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    // Scrobble
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;

                        Text {
                            text: I18n.scrobble_title;
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        CampoImersivo {
                            texto <=> root.listenbrainz_token;
                            placeholder: I18n.listenbrainz_token;
                            senha: true;
                            cor: root.destaque;
                            editado(t) => { root.listenbrainz_mudou(t); }
                        }
                        Text {
                            text: I18n.lastfm_keys;
                            color: #ffffffb3;
                            font-size: 13px;
                        }
                        HorizontalLayout {
                            spacing: 8px;

                            CampoImersivo {
                                texto <=> root.lastfm_chave;
                                placeholder: I18n.lastfm_key;
                                cor: root.destaque;
                                editado(t) => { root.lastfm_credenciais_mudou(t, root.lastfm_segredo); }
                            }
                            CampoImersivo {
                                texto <=> root.lastfm_segredo;
                                placeholder: I18n.lastfm_secret;
                                senha: true;
                                cor: root.destaque;
                                editado(t) => { root.lastfm_credenciais_mudou(root.lastfm_chave, t); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;

                            BotaoTexto {
                                texto: root.lastfm_conectado ? I18n.lastfm_disconnect : (root.lastfm_aguardando ? I18n.lastfm_finish : I18n.lastfm_connect);
                                clicado => {
                                    if (root.lastfm_conectado) {
                                        root.lastfm_desconectar();
                                    } else if (root.lastfm_aguardando) {
                                        root.lastfm_concluir();
                                    } else {
                                        root.lastfm_conectar();
                                    }
                                }
                            }
                            Text {
                                text: root.lastfm_estado;
                                color: #ffffff80;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: root.scrobble_estado != "" ? root.scrobble_estado : I18n.scrobble_desc;
                            color: #ffffff80;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #ffffff14;
                    }

                    // Fundo da tela cheia
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 4px;
                        spacing: 8px;

                        Text {
                            text: I18n.bg_label;
                            color: #ffffff;
                            font-size: 14px;
                        }
                        Text {
                            text: root.fundo_global_nome != "" ? root.fundo_global_nome : I18n.bg_none;
                            color: #ffffff80;
                            font-size: 12px;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;

                            BotaoTexto {
                                texto: I18n.bg_choose;
                                clicado => { root.escolher_fundo(); }
                            }
                            if root.fundo_global_nome != "" : BotaoTexto {
                                texto: I18n.bg_clear;
                                clicado => { root.limpar_fundo(); }
                            }
                        }
                    }

                    // Sem FFmpeg: o que fica de fora e onde conseguir
                    if root.ffmpeg_ausente : VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            text: I18n.ffmpeg_missing;
                            color: #ffffff80;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;

                            BotaoTexto {
                                texto: I18n.ffmpeg_get;
                                clicado => { root.abrir_pagina_ffmpeg(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // -------------------------------------------------------------
    // Painel da biblioteca: desliza da direita
    // -------------------------------------------------------------
    painel := PainelBiblioteca {
        width: min(500px, root.width * 0.4);
        height: root.height;
        x: root.painel_aberto ? root.width - self.width : root.width;
        animate x { duration: 280ms; easing: ease-out; }
        visible: self.x < root.width;

        abas: root.abas;
        aba_ativa: root.aba_ativa;
        aba_tocando: root.aba_tocando;
        texto_busca <=> root.texto_busca;
        total: root.painel_total;
        primeira: root.painel_primeira;
        linhas: root.painel_linhas;
        fila: root.fila;
        selecionado: root.selecionado;
        pedido_rolar: root.pedido_rolar;
        pedido_busca: root.pedido_busca;
        cor: root.destaque;
        barras: root.barras;
        albuns: root.albuns;
        guia <=> root.guia;
        ordem_atual: root.ordem_atual;
        opcoes_ordem: root.opcoes_ordem;
        especiais: root.especiais;

        guia_mudou(g) => { root.guia_mudou(g); }
        albuns_rolou(a, b) => { root.albuns_rolou(a, b); }
        album_clicado(i) => { root.album_clicado(i); }
        ordem_escolhida(i) => { root.ordem_escolhida(i); }
        favorita_alternada(i) => { root.favorita_alternada(i); }
        aba_selecionada(i) => { root.aba_selecionada(i); }
        busca_mudou(t) => { root.busca_mudou(t); }
        rolou(a, b) => { root.painel_rolou(a, b); }
        linha_clicada(i) => { root.linha_clicada(i); }
        fila_clicada(i) => { root.fila_clicada(i); }
        devolver_foco => { root.devolver_foco(); }
        fechar => { root.painel_aberto = false; }
    }
}
